---
import { taalPaden, t, pad } from '../../i18n/index.ts';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('contact');
import { getPaginaSeo } from '../../lib/sanity.ts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { contact } from '../../data/content.js';
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "ct.intro")} title={`${t(taal, "ct.titel")} — Stichting Gema Rasa`}>
  <PageHero
    sleutel="contact"
    eyebrow={t(taal, "ct.eyebrow")}
    titel={t(taal, "ct.titel")}
    tekst={t(taal, "ct.intro")}
    foto="/assets/perf4.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="split">
        <div>
          <form class="cform" data-formulier="contact" data-bedankt={t(taal, "ct.bedankt")}>
            <div>
              <label for="naam">{t(taal, "ct.naam")}</label>
              <input id="naam" name="naam" type="text" required />
            </div>
            <div>
              <label for="email">{t(taal, "ct.email")}</label>
              <input id="email" name="email" type="email" required />
            </div>
            <div>
              <label for="onderwerp">{t(taal, "ct.onderwerp")}</label>
              <input id="onderwerp" name="onderwerp" type="text" />
            </div>
            <div>
              <label for="bericht">{t(taal, "ct.bericht")}</label>
              <textarea id="bericht" name="bericht" required></textarea>
            </div>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
            <button class="btn gold" type="submit" style="justify-self:start">{t(taal, "ct.verstuur")}</button>
            <p class="form-status" data-status role="status" aria-live="polite"></p>
            <p style="font-family:'Poppins';font-size:12.5px;color:var(--gray);line-height:1.5">{t(taal, "ct.privacy")}</p>
          </form>
        </div>
        <div>
          <div class="section-head" style="margin-bottom:20px">
            <span class="kicker">{t(taal, "ct.locatiesKicker")}</span>
            <h2 style="font-size:26px">{t(taal, "ct.locatiesTitel")}</h2>
          </div>
          <div class="info-cards">
            {contact.locaties.map((l) => (
              <div class="info-card">
                <h3>{l.plaats}</h3>
                <p>{l.adres}</p>
                <a href={`tel:${contact.telefoon.replace(/[^+0-9]/g, '')}`}>{contact.telefoon}</a>
                <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </div>
            ))}
          </div>
          {/*
            Waar we oefenen, los van het vestigingsadres hierboven. Dit is een
            zaal die we huren en geen kantoor van de stichting -- vandaar een
            eigen kopje, en geen telefoonnummer erbij: mensen moeten ons
            bellen, niet de zaal.
          */}
          {contact.oefenlocatie && (
            <div class="oefenkaart">
              <h3>{t(taal, "ct.oefenKop")}</h3>
              <p class="oefenadres">
                <strong>{contact.oefenlocatie.naam}</strong><br />
                {contact.oefenlocatie.adres}
              </p>
              <p>{t(taal, "ct.oefenTekst")}</p>
              <a href={contact.oefenlocatie.maps} target="_blank" rel="noopener">{t(taal, "ct.oefenRoute")} →</a>
            </div>
          )}

          <p style="font-family:'Poppins';font-weight:300;font-size:13px;color:var(--gray);margin-top:16px">
            KVK: {contact.kvk} &middot; BTW: {contact.btw}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="zoektplek">
        <span class="kicker">{t(taal, "ct.zoektKop")}</span>
        <p>{t(taal, "ct.zoektTekst")}</p>
        <a class="btn gold" href={`mailto:${contact.email}?subject=${encodeURIComponent('Een plek voor de gamelan')}`}>
          {t(taal, "ct.zoektKnop")}
        </a>
      </div>
    </div>
  </section>

</Base>

<style>
  .oefenkaart {
    margin-top: 22px; padding: 20px 22px;
    border: 1px solid var(--line); border-radius: 4px; background: #fff;
  }
  .oefenkaart h3 { margin: 0 0 10px; font-size: 19px; font-weight: 400; }
  .oefenkaart p { font-family: 'Poppins', sans-serif; font-weight: 300; font-size: 14.5px; color: #4a4a4a; margin: 0 0 10px; }
  .oefenkaart .oefenadres { font-weight: 400; color: var(--ink); }
  .oefenkaart a { font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 500; }

  .zoektplek { max-width: 760px; }
  .zoektplek p {
    font-family: 'Poppins', sans-serif; font-weight: 300;
    font-size: 16px; line-height: 1.75; color: #4a4a4a; margin: 14px 0 22px;
  }
</style>

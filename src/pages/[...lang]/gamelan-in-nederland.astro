    knopCursus: 'Mulai dengan kursus gratis',
    knopOrkest: 'Tentang Jiwa Manunggal',

    vragenKicker: 'Pertanyaan yang sering diajukan',
    vragenKop: 'Gamelan di Belanda',
    bronKop: 'Sumber',
    bron:
      'Keterangan tentang Het Gamelanhuis dan orkes-orkes yang berlatih di sana berasal dari <a href="%GAMELANHUIS%" rel="noopener" target="_blank">gamelanhuis.nl</a>. Pameran 1883 dan kampung Jawa di Museumplein diuraikan dalam <a href="%KAMPONG%" rel="noopener" target="_blank">Liesbeth Ouwehand, ‘Indië in Amsterdam’, De Boekenwereld 32</a> (berbahasa Belanda). Yang tertulis di sini tentang instrumennya sendiri mengikuti Sumarsam, <em>Introduction, Theory, and Analysis: Javanese Gamelan</em> (Middletown CT, 2023); uraian lebih lengkap ada di <a href="%WATISGAMELAN%">Apa itu gamelan</a>.',

    plekken: [
      {
        waar: 'Amsterdam',
        wie: 'Het Gamelanhuis',
        wat: 'Sebuah kolektif di Pakhuis Wilhelmina yang sejak 1990 menaungi tujuh orkes gamelan, dengan dua ruang untuk latihan dan pertunjukan. Antara lain Widosari, Wiludyeng, Gong Tirta, Mugi Rahayu, Global Gongs, Multifoon dan Babar Layar berlatih di sana.',
      },
      {
        waar: 'Rotterdam',
        wie: 'Jiwa Manunggal',
        wat: 'Orkes kami sendiri, dalam tiga kelompok menurut usia. Kami berlatih di KizzMotions, Hoogvliet. Datanglah menonton atau ikut bermain.',
      },
      {
        waar: 'Di museum',
        wie: 'Wereldmuseum Leiden dan Amsterdam',
        wat: 'Dalam koleksi Nationaal Museum van Wereldculturen tersimpan instrumen Jawa yang sampai ke Belanda pada masa kolonial. Bukan untuk dimainkan, melainkan untuk melihat dari mana semua ini berasal.',
      },
    ],

    vragen: [
      {
        v: 'Di mana saya bisa bermain gamelan di Belanda?',
        a: 'Ada dua tempat yang terbuka tanpa pengalaman. Di Amsterdam, Het Gamelanhuis berada di Pakhuis Wilhelmina, sebuah kolektif yang sejak 1990 menaungi tujuh orkes gamelan. Di Rotterdam, orkes kami Jiwa Manunggal berlatih di KizzMotions, Hoogvliet; silakan datang menonton atau ikut bermain.',
      },
      {
        v: 'Apakah saya harus bisa membaca not untuk bermain gamelan?',
        a: 'Tidak. Gamelan adalah tradisi lisan: Anda belajar dengan mendengarkan dan menirukan, di samping orang yang sudah bisa. Notasi memang ada — kepatihan, notasi angka — tetapi itu alat bantu ingatan, bukan partitur yang dimainkan.',
      },
      {
        v: 'Apakah saya perlu instrumen sendiri?',
        a: 'Tidak, dan membelinya untuk di rumah pun tidak mungkin. Gamelan adalah satu instrumen yang dibuat dan dilaras sebagai satu kesatuan dan dimainkan bersama oleh sekelompok orang. Jadi Anda selalu bermain pada perangkat kelompok yang Anda masuki.',
      },
      {
        v: 'Bagaimana gamelan bisa sampai ke Belanda?',
        a: 'Lewat hubungan kolonial dengan Indonesia. Pada Internationale Koloniale en Uitvoerhandel Tentoonstelling di Amsterdam, 1 Mei sampai 1 Oktober 1883, berdiri sebuah kampung Jawa dengan satu perangkat gamelan utuh di Museumplein; sekitar tiga puluh delapan orang yang didatangkan untuk itu memainkan gamelan dan wayang di depan publik. Pada masa yang sama instrumen Jawa masuk ke koleksi museum yang kini menjadi bagian Nationaal Museum van Wereldculturen.',
      },
      {
        v: 'Apa itu gamelan Jawa-Suriname?',
        a: 'Sejak 1890 pekerja kontrak Jawa datang ke Suriname, dan mereka membawa musiknya. Setelah 1975 sebagian besar keturunan mereka pindah ke Belanda. Gamelan itu menempuh jalan yang berbeda dari instrumen yang datang langsung dari Jawa, dan pada beberapa bagian bunyinya pun berbeda. Stichting Gema Rasa berasal dari tradisi itu.',
      },
      {
        v: 'Apakah ikut bermain berbayar?',
        a: 'Di tempat kami ada iuran tahunan; besarnya akan kami sampaikan bila Anda menghubungi kami. Bila ingin lebih dulu mencoba di rumah, kursus daring kami gratis — enam belas pelajaran singkat, tanpa akun dan tanpa instrumen, berbahasa Belanda.',
      },
    ],
  },
};

const c = INHOUD[taal] ?? INHOUD.nl;
const waarNaHtml = c.waarNa.replace('%GAMELANHUIS%', GAMELANHUIS);
const bronHtml = c.bron
  .replace('%GAMELANHUIS%', GAMELANHUIS)
  .replace('%KAMPONG%', KAMPONG1883)
  .replace('%WATISGAMELAN%', pad(taal, '/wat-is-gamelan'));
---

<Base taal={taal} title={c.titel} description={c.omschrijving}>
  <PageHero
    sleutel="gamelan-in-nederland"
    eyebrow={c.eyebrow}
    titel={c.kop}
    tekst={c.heroTekst}
    foto="/assets/perf-gamelan.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="prose">
        <p class="lead" set:html={c.lead} />
        <p>{c.intro2}</p>
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.waarKicker}</span>
        <h2>{c.waarKop}</h2>
      </div>
      <div class="tabelwrap">
        <table class="gamtabel">
          <thead>
            <tr><th>{c.tabelPlaats}</th><th>{c.tabelWie}</th><th>{c.tabelWat}</th></tr>
          </thead>
          <tbody>
            {c.plekken.map((p) => (
              <tr>
                <td><strong>{p.waar}</strong></td>
                <td>{p.wie}</td>
                <td class="jw">{p.wat}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose">
        <p set:html={waarNaHtml} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.geschKicker}</span>
        <h2>{c.geschKop}</h2>
      </div>
      <div class="prose">
        <p set:html={c.gesch1} />
        <p set:html={c.gesch2} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.wegenKicker}</span>
        <h2>{c.wegenKop}</h2>
      </div>
      <div class="prose">
        <p>{c.wegen1}</p>
        <p>{c.wegen2}</p>
      </div>
      <p class="gamknoppen">
        <a class="btn" href={pad(taal, '/surinaams-javaans')}>{c.knopSurjav}</a>
      </p>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.meedoenKicker}</span>
        <h2>{c.meedoenKop}</h2>
      </div>
      <div class="prose">
        <p>{c.meedoen1}</p>
        <p>{c.meedoen2}</p>
        <p>{c.meedoen3}</p>
      </div>
      <p class="gamknoppen">
        <a class="btn gold" href={pad(taal, '/contact')}>{c.knopMeespelen}</a>
        <a class="btn" href={pad(taal, '/gamelancursus')}>{c.knopCursus}</a>
        <a class="btn" href={pad(taal, '/de-gamelan-groep')}>{c.knopOrkest}</a>
      </p>
    </div>
  </section>

  <Vragen kicker={c.vragenKicker} titel={c.vragenKop} vragen={c.vragen} />

  <section class="block vervolg">
    <div class="wrap">
      <div class="prose bronnen">
        <h3>{c.bronKop}</h3>
        <p set:html={bronHtml} />
      </div>
    </div>
  </section>
</Base>

<style>
  .tabelwrap { overflow-x: auto; margin-top: 8px; }
  .gamtabel { border-collapse: collapse; width: 100%; max-width: 760px; font-size: 15px; }
  .gamtabel th, .gamtabel td { text-align: left; padding: 11px 16px 11px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .gamtabel th { font-weight: 600; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .gamtabel .jw { color: var(--muted); }
  .gamknoppen { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .bronnen { font-size: 15px; color: var(--muted); }
  .bronnen h3 { font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
</style>

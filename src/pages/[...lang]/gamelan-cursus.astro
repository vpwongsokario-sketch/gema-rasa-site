---
/**
 * Gratis videocursus "Gamelan vanaf de basis" — testversie voor intern gebruik.
 *
 * Staat bewust niet in het menu en niet in de sitemap (noindex), zodat we hem
 * eerst binnen de stichting kunnen testen. Alle inhoud komt uit
 * src/data/gamelan-cursus.json: vul daar per les `youtube_id` in (een
 * niet-openbare YouTube-video), of `video` met een eigen mp4-URL.
 *
 * De video's zelf staan niet in deze repo: Cloudflare Pages accepteert geen
 * bestanden groter dan 25 MB, en video's horen niet in git.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { contact } from '../../data/content.js';
import cursus from '../../data/gamelan-cursus.json';

// Alleen Nederlands: de lessen zelf zijn Engels gesproken, de pagina eromheen
// is voor de testgroep binnen de stichting.
export function getStaticPaths() {
  return [{ params: { lang: undefined }, props: { taal: 'nl' } }];
}
const { taal } = Astro.props;

const lessen = cursus.lessons;
const modules = cursus.modules.map((m) => ({
  ...m,
  lessen: lessen.filter((l) => m.lessons.includes(l.nr)),
}));
const letters = ['A', 'B', 'C', 'D'];
const pdf = '/assets/gamelan-cursus/gamelan-lesbladen-en-quiz.pdf';
const feedback = `mailto:${contact.email}?subject=${encodeURIComponent('Feedback videocursus gamelan')}`;
---
<Base
  taal={taal}
  noindex={true}
  ogImage="/assets/gamelan-cursus/thumb_les1.jpg"
  description="Gratis videocursus Centraal-Javaanse gamelan: 16 korte lessen met oefeningen, lesbladen en een quiz."
  title="Gamelan vanaf de basis — Stichting Gema Rasa"
>
  <PageHero
    eyebrow="Gratis videocursus · testversie"
    titel="Gamelan vanaf de basis"
    tekst="Leer Centraal-Javaanse gamelan stap voor stap: van de eerste gongslag tot je eerste stukken. Zestien korte lessen met uitleg, oefeningen om mee te spelen, een lesblad en een quiz."
    foto="/assets/perf-gamelan.jpg"
  >
    <div class="hero-cta">
      <a class="btn gold" href="#les-1">Begin bij les 1</a>
      <a class="btn ghost gc-licht" href={pdf} download>Handboek (PDF)</a>
    </div>
  </PageHero>

  <div class="gc-strook">
    <div class="wrap">
      <span>16 lessen in 4 modules</span>
      <span>± 5 minuten per les</span>
      <span>Gesproken in het Engels</span>
      <span>Lesblad en quiz bij elke les</span>
    </div>
  </div>

  <section class="block">
    <div class="wrap">
      <div class="gc-test">
        <div>
          <span class="gc-test-kop">Testversie voor de stichting</span>
          <p>Deze cursus staat nog niet in het menu. Kijk een paar lessen, doe de quiz, en laat ons weten wat klopt, wat niet klopt en wat beter kan. Let vooral op de uitspraak van de Javaanse woorden en op de muzikale uitleg.</p>
        </div>
        <a class="btn" href={feedback}>Geef feedback</a>
      </div>

      <div class="gc-voortgang" data-gc-voortgang hidden>
        <div class="gc-balk"><span data-gc-balk></span></div>
        <p><b data-gc-aantal>0</b> van de {lessen.length} lessen gezien</p>
      </div>

      <div class="gc-hoe">
        <div><h3>Kijk op volgorde</h3><p>Elke les bouwt voort op de vorige. Begin bij les 1, ook als je al wat speelt.</p></div>
        <div><h3>Speel mee</h3><p>In de oefeningen licht de tel op. Geen gamelan in de buurt? Tik mee op tafel.</p></div>
        <div><h3>Zeg het hardop</h3><p>De Javaanse woorden worden uitgesproken. Zeg ze na, dan blijven ze hangen.</p></div>
        <div><h3>Test jezelf</h3><p>Open onder elke les het lesblad en doe de quiz van vier vragen.</p></div>
      </div>
    </div>
  </section>

  {modules.map((m, mi) => (
    <section class={`block ${mi % 2 === 1 ? 'batik' : ''}`} id={`module-${m.nr}`}>
      <div class="wrap">
        <div class="section-head">
          <span class="kicker">{m.label}</span>
          <h2>{m.title_nl}</h2>
          <p>Les {m.lessons[0]} tot en met {m.lessons[m.lessons.length - 1]}</p>
        </div>

        <div class="gc-lessen">
          {m.lessen.map((l) => (
            <article class="gc-les" id={`les-${l.nr}`} data-les={l.nr}>
              <button
                class="gc-speler"
                type="button"
                data-yt={l.youtube_id}
                data-mp4={l.video}
                aria-label={`Speel les ${l.nr}: ${l.title}`}
              >
                <img src={l.thumbnail} alt="" width="960" height="540" loading="lazy" />
                {(l.youtube_id || l.video)
                  ? <span class="gc-play" aria-hidden="true"></span>
                  : <span class="gc-binnenkort">video volgt binnenkort</span>}
              </button>

              <div class="gc-body">
                <div class="gc-kop">
                  <span class="gc-nr">Les {l.nr}</span>
                  <label class="gc-gezien">
                    <input type="checkbox" data-gc-gezien={l.nr} /> gezien
                  </label>
                </div>
                <h3>{l.title}</h3>
                <p class="gc-samenvatting">{l.summary_nl}</p>
                <p class="gc-oefening"><b>Oefening:</b> {l.oefening_nl}</p>

                <details class="gc-lesblad">
                  <summary>Lesblad &amp; quiz</summary>
                  <div class="gc-lesblad-in" lang="en">
                    <h4>Key ideas</h4>
                    <ul>{l.sheet.key_ideas.map((k) => <li>{k}</li>)}</ul>
                    <h4>Words</h4>
                    <dl>{l.sheet.words.map((w) => <><dt>{w.word}</dt><dd>{w.meaning}</dd></>)}</dl>
                    <h4>Practice</h4>
                    <p>{l.sheet.practice}</p>
                    <h4>Quiz</h4>
                    <div class="gc-quiz" data-gc-quiz>
                      {l.sheet.quiz.map((q, qi) => (
                        <fieldset class="gc-vraag">
                          <legend>{qi + 1}. {q.question}</legend>
                          {q.options.map((o, oi) => (
                            <button type="button" class="gc-optie" data-goed={oi === q.correct ? '1' : undefined}>
                              <span>{letters[oi]}</span>{o}
                            </button>
                          ))}
                          <p class="gc-uitleg">{q.explanation}</p>
                        </fieldset>
                      ))}
                      <p class="gc-score" aria-live="polite" lang="nl"></p>
                    </div>
                  </div>
                </details>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="block">
    <div class="wrap">
      <div class="split">
        <div class="info-card">
          <h3>Handboek</h3>
          <p>Alle zestien lesbladen met kernpunten, woorden, oefeningen en quiz in één PDF. Om te printen of naast de video te houden. De antwoorden staan achterin.</p>
          <a class="btn gold" href={pdf} download>Download het handboek (PDF)</a>
        </div>
        <div class="info-card">
          <h3>Over deze cursus</h3>
          <p>Gebaseerd op Jo Hilder, <i>Central Javanese Gamelan Handbook</i> (1992); Sumarsam, <i>Introduction, Theory, and Analysis: Javanese Gamelan</i> (2023); Barry Drummond, <i>Javanese Gamelan Terminology</i>.</p>
          <p>De stem en de tekeningen zijn met AI gemaakt. De instrumenten klinken met opnames van een echte gamelan (samples van Casa da Música, Porto). Elke gamelan heeft zijn eigen stemming. Oefenmelodieën met "written for this course" zijn oefeningen, geen traditionele stukken.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .gc-strook { background: var(--primary); }
  .gc-strook .wrap {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 40px;
    padding-top: 14px; padding-bottom: 14px;
    font-family: 'Poppins', sans-serif; font-size: 13.5px; font-weight: 500; color: var(--primary-dark);
  }
  .gc-strook span { display: flex; align-items: center; gap: 8px; }
  .gc-strook span::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--primary-dark); flex: none; }

  .gc-test {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 28px;
    background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--orange); border-radius: 14px;
    padding: 22px 26px;
  }
  .gc-test > div { flex: 1 1 420px; }
  .gc-test-kop {
    font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 600; letter-spacing: .12em;
    text-transform: uppercase; color: var(--orange-ink);
  }
  .gc-test p { font-family: 'Poppins', sans-serif; font-weight: 300; font-size: 15px; color: #4a4a4a; margin-top: 6px; }

  .gc-voortgang { margin-top: 26px; font-family: 'Poppins', sans-serif; font-size: 14px; color: var(--gray); }
  .gc-voortgang b { color: var(--primary-dark); }
  .gc-balk { height: 8px; background: rgba(9,53,31,.08); border-radius: 99px; overflow: hidden; margin-bottom: 8px; }
  .gc-balk span { display: block; height: 100%; width: 0; background: var(--secondary); transition: width .4s ease; }

  .gc-hoe { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 18px; margin-top: 34px; }
  .gc-hoe div { border-top: 3px solid var(--primary); padding-top: 14px; }
  .gc-hoe h3 { font-size: 19px; font-weight: 700; color: var(--primary-dark); margin-bottom: 6px; }
  .gc-hoe p { font-family: 'Poppins', sans-serif; font-weight: 300; font-size: 14.5px; color: #4a4a4a; }

  .gc-lessen { display: flex; flex-direction: column; gap: 26px; }
  .gc-les {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 0;
    background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
    scroll-margin-top: 100px;
  }
  .gc-speler {
    position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; align-self: start;
    border: 0; padding: 0; background: var(--primary-dark); cursor: pointer;
    position: sticky; top: 96px;
  }
  .gc-licht { color: var(--cream); border-color: rgba(244,243,232,.7); }
  .gc-licht:hover { background: rgba(244,243,232,.12); color: var(--cream); }
  .gc-speler img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .gc-speler iframe, .gc-speler video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; }
  .gc-play {
    position: absolute; left: 50%; top: 50%; width: 68px; height: 68px; margin: -34px 0 0 -34px;
    border-radius: 50%; background: var(--primary); box-shadow: 0 6px 24px rgba(0,0,0,.25);
    transition: transform .18s ease;
  }
  .gc-play::after {
    content: ""; position: absolute; left: 27px; top: 21px;
    border-left: 19px solid var(--primary-dark); border-top: 13px solid transparent; border-bottom: 13px solid transparent;
  }
  .gc-speler:hover .gc-play { transform: scale(1.06); }
  .gc-speler:focus-visible { outline: 3px solid var(--orange); outline-offset: -3px; }
  .gc-binnenkort {
    position: absolute; left: 12px; bottom: 12px; background: rgba(9,53,31,.85); color: var(--cream);
    font-family: 'Poppins', sans-serif; font-size: 12.5px; padding: 4px 10px; border-radius: 6px;
  }

  .gc-body { padding: 24px 28px 26px; display: flex; flex-direction: column; }
  .gc-kop { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .gc-nr {
    font-family: 'Poppins', sans-serif; font-size: 11.5px; font-weight: 600; letter-spacing: .12em;
    text-transform: uppercase; color: var(--orange-ink);
  }
  .gc-gezien {
    display: inline-flex; align-items: center; gap: 6px; cursor: pointer;
    font-family: 'Poppins', sans-serif; font-size: 13px; color: var(--gray);
  }
  .gc-gezien input { accent-color: var(--secondary); width: 16px; height: 16px; }
  .gc-les h3 { font-size: 25px; font-weight: 700; color: var(--primary-dark); margin: 6px 0 10px; }
  .gc-samenvatting { font-family: 'Poppins', sans-serif; font-weight: 300; font-size: 15px; color: #4a4a4a; }
  .gc-oefening {
    margin-top: 12px; padding-left: 12px; border-left: 3px solid var(--secondary);
    font-family: 'Poppins', sans-serif; font-size: 14px; color: var(--secondary);
  }
  .gc-oefening b { font-weight: 600; }

  .gc-lesblad { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 12px; }
  .gc-lesblad summary {
    cursor: pointer; list-style: none; font-family: 'Poppins', sans-serif; font-weight: 500; font-size: 14.5px;
    color: var(--primary-dark); display: flex; align-items: center; gap: 8px;
  }
  .gc-lesblad summary::-webkit-details-marker { display: none; }
  .gc-lesblad summary::before {
    content: "+"; width: 22px; height: 22px; border-radius: 50%; background: var(--primary);
    display: inline-flex; align-items: center; justify-content: center; font-weight: 600;
  }
  .gc-lesblad[open] summary::before { content: "−"; }
  .gc-lesblad-in { font-family: 'Poppins', sans-serif; font-size: 14px; color: #4a4a4a; }
  .gc-lesblad-in h4 {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: .12em;
    text-transform: uppercase; color: var(--gray); margin: 18px 0 6px;
  }
  .gc-lesblad-in ul { padding-left: 18px; display: flex; flex-direction: column; gap: 4px; font-weight: 300; }
  .gc-lesblad-in p { font-weight: 300; }
  .gc-lesblad-in dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 14px; }
  .gc-lesblad-in dt { font-weight: 600; color: var(--primary-dark); }
  .gc-lesblad-in dd { font-weight: 300; }

  .gc-vraag { border: 0; padding: 0; margin: 14px 0 0; }
  .gc-vraag legend { font-weight: 500; color: var(--ink); margin-bottom: 6px; padding: 0; }
  .gc-optie {
    display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; cursor: pointer;
    background: var(--cream); border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; margin: 5px 0;
    font: inherit; font-weight: 300; color: var(--ink); transition: border-color .15s ease;
  }
  .gc-optie span {
    flex: none; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid var(--primary-dark);
    display: inline-flex; align-items: center; justify-content: center; font-size: 11.5px; font-weight: 600;
  }
  .gc-optie:hover:not(:disabled) { border-color: var(--secondary); }
  .gc-optie:disabled { cursor: default; }
  .gc-optie.goed { background: rgba(19,102,61,.12); border-color: var(--secondary); }
  .gc-optie.goed span { background: var(--secondary); border-color: var(--secondary); color: #fff; }
  .gc-optie.fout { background: rgba(168,78,24,.10); border-color: var(--orange-ink); }
  .gc-optie.fout span { background: var(--orange-ink); border-color: var(--orange-ink); color: #fff; }
  .gc-uitleg { display: none; color: var(--secondary); font-size: 13.5px; margin-top: 2px; }
  .gc-vraag.klaar .gc-uitleg { display: block; }
  .gc-score { margin-top: 14px; font-weight: 500; color: var(--primary-dark); }

  @media (max-width: 860px) {
    .gc-les { grid-template-columns: 1fr; }
    .gc-speler { position: relative; top: auto; }
    .gc-body { padding: 20px 20px 22px; }
  }
</style>

<script>
  // Video's laden pas bij een klik: geen YouTube-cookies of zware iframes vooraf.
  document.querySelectorAll<HTMLButtonElement>('.gc-speler').forEach((knop) => {
    knop.addEventListener('click', () => {
      const yt = knop.dataset.yt;
      const mp4 = knop.dataset.mp4;
      if (yt) {
        knop.insertAdjacentHTML('beforeend',
          `<iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(yt)}?autoplay=1&rel=0" title="${knop.getAttribute('aria-label')}" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>`);
      } else if (mp4) {
        const v = document.createElement('video');
        v.src = mp4; v.controls = true; v.autoplay = true; v.playsInline = true;
        knop.appendChild(v);
      } else return;
      knop.style.cursor = 'default';
      const les = knop.closest<HTMLElement>('.gc-les')?.dataset.les;
      if (les) zetGezien(les, true);
    }, { once: true });
  });

  // Quiz: één antwoord per vraag, direct goed/fout, score na de laatste vraag.
  document.querySelectorAll<HTMLElement>('[data-gc-quiz]').forEach((quiz) => {
    const vragen = quiz.querySelectorAll<HTMLElement>('.gc-vraag');
    vragen.forEach((vraag) => {
      const opties = vraag.querySelectorAll<HTMLButtonElement>('.gc-optie');
      opties.forEach((optie) => optie.addEventListener('click', () => {
        if (vraag.classList.contains('klaar')) return;
        vraag.classList.add('klaar');
        const goed = optie.dataset.goed === '1';
        optie.classList.add(goed ? 'goed' : 'fout');
        if (goed) vraag.dataset.goed = '1';
        else vraag.querySelector('.gc-optie[data-goed]')?.classList.add('goed');
        opties.forEach((o) => (o.disabled = true));
        const klaar = quiz.querySelectorAll('.gc-vraag.klaar').length;
        if (klaar === vragen.length) {
          const score = quiz.querySelectorAll('.gc-vraag[data-goed]').length;
          const el = quiz.querySelector('.gc-score');
          if (el) el.textContent = `${score} van de ${vragen.length} goed. ` +
            (score === vragen.length ? 'Mooi!' : 'Kijk dat stukje van de video nog eens terug.');
        }
      }));
    });
  });

  // Voortgang: per bezoeker in de eigen browser bewaard. Werkt het opslaan niet
  // (privévenster, geblokkeerde opslag), dan werkt de pagina gewoon zonder.
  const SLEUTEL = 'gc-gezien';
  const lees = (): string[] => { try { return JSON.parse(localStorage.getItem(SLEUTEL) || '[]'); } catch { return []; } };
  const schrijf = (l: string[]) => { try { localStorage.setItem(SLEUTEL, JSON.stringify(l)); } catch {} };
  const vakjes = document.querySelectorAll<HTMLInputElement>('[data-gc-gezien]');
  const toon = () => {
    const gezien = lees();
    vakjes.forEach((v) => (v.checked = gezien.includes(v.dataset.gcGezien || '')));
    const balk = document.querySelector<HTMLElement>('[data-gc-balk]');
    const aantal = document.querySelector('[data-gc-aantal]');
    const blok = document.querySelector<HTMLElement>('[data-gc-voortgang]');
    if (balk) balk.style.width = `${(gezien.length / vakjes.length) * 100}%`;
    if (aantal) aantal.textContent = String(gezien.length);
    if (blok) blok.hidden = false;
  };
  function zetGezien(les: string, aan: boolean) {
    const s = new Set(lees());
    if (aan) s.add(les); else s.delete(les);
    schrijf([...s]); toon();
  }
  vakjes.forEach((v) => v.addEventListener('change', () => zetGezien(v.dataset.gcGezien || '', v.checked)));
  toon();
</script>

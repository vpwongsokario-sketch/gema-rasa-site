---
import { taalPaden, t, pad } from '../../i18n/index.ts';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('menukaart');
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { catName } from '../../data/programmas.js';
import { getProgrammas , getPaginaSeo, getMenukaartVideos } from '../../lib/sanity.ts';
const programmas = await getProgrammas();
const videos = await getMenukaartVideos();

/*
  Drieëntwintig volle kaarten onder elkaar vraagt van een bezoeker dat hij
  drieëntwintig dingen tegen elkaar afweegt, en dat doet niemand. Wie hier
  komt heeft al een gelegenheid in zijn hoofd -- een opening, een schoolklas,
  een hele middag -- en zoekt alleen waar hij moet beginnen.

  Daarom staan de drie meest geboekte programma's bovenaan als volle kaart met
  foto en beschrijving, en staat de rest eronder als compacte regel per soort.
  Het aanbod wordt niet kleiner; wat je in één keer moet overzien wel.

  De indeling komt uit het veld `categorie` in Sanity. Is er geen enkel
  programma als 'populair' aangemerkt, dan valt het uitgelichte blok weg en
  komt alles in de groepen te staan -- de pagina blijft dus heel, wat
  vrijwilligers daar ook invullen.
*/
const uitgelicht = programmas.filter((p) => p.cat === 'populair');
const rest = uitgelicht.length > 0 ? programmas.filter((p) => p.cat !== 'populair') : programmas;

// Vaste volgorde voor de soorten die we kennen; een onbekende soort uit Sanity
// komt erachter in een eigen groep in plaats van stil te verdwijnen.
const voorkeur = ['optredens', 'workshops', 'verhalen', 'extra'];
const aanwezig = [...new Set(rest.map((p) => p.cat))];
const groepOrde = [
  ...voorkeur.filter((c) => aanwezig.includes(c)),
  ...aanwezig.filter((c) => !voorkeur.includes(c)),
];
const groepen = groepOrde.map((cat) => ({ cat, items: rest.filter((p) => p.cat === cat) }));

/* De naam van een soort in de taal van de bezoeker. Staat er geen vertaling,
   dan valt hij terug op de Nederlandse naam uit de lijst. */
/*
  Soorten waarvan de programma's in feite één product zijn met verschillende
  onderwerpen.

  De zes verhalen en keynotes duren allemaal een halfuur tot drie kwartier en
  kosten tussen de 440 en 550 euro. Een klant kiest daar dus niet op duur of
  prijs -- die zijn vrijwel gelijk -- maar op onderwerp. Zes losse regels
  dwongen hem zes keer dezelfde afweging te maken voordat hij doorhad dat het
  telkens hetzelfde formaat was.

  Ze staan nu als één regel met de onderwerpen eronder. Elk onderwerp houdt
  zijn eigen link naar het aanvraagformulier, dus een gedeelde link naar
  bijvoorbeeld De Overtocht blijft gewoon werken.
*/
const samengevoegd = ['verhalen'];

/** Haalt de getallen uit een tekst als '30–45 min' of '€1.100'. */
function getallenUit(tekst) {
  const schoon = String(tekst ?? '').replace(/(\d)[.,](\d{3})/g, '$1$2');
  const gevonden = schoon.match(/\d+/g);
  return gevonden ? gevonden.map(Number) : [];
}

/** '30–45 min' uit een reeks programma's; leeg als de duur niet in minuten staat. */
function duurBereik(items) {
  // '± 2–2,5 uur' zou als getallen 2 en 5 opleveren, en dus '2–5 min'. Liever
  // niets tonen dan iets verkeerds, dus alleen rekenen als alles in minuten is.
  const allesInMinuten = items.every((i) => /^[^0-9]*\d+(\s*[–-]\s*\d+)?\s*min/i.test(String(i.dur ?? '')));
  if (!allesInMinuten) return '';
  const waarden = items.flatMap((i) => getallenUit(i.dur));
  if (waarden.length === 0) return '';
  const laag = Math.min(...waarden);
  const hoog = Math.max(...waarden);
  return laag === hoog ? `${laag} min` : `${laag}–${hoog} min`;
}

/** '€440 – €550' uit een reeks programma's. */
function prijsBereik(items) {
  const waarden = items.flatMap((i) => getallenUit(i.price));
  if (waarden.length === 0) return '';
  const laag = Math.min(...waarden);
  const hoog = Math.max(...waarden);
  return laag === hoog ? `€${laag}` : `€${laag} – €${hoog}`;
}

function groepNaam(cat) {
  const sleutel = `mk.cat.${cat}`;
  const vertaald = t(taal, sleutel);
  return vertaald === sleutel ? (catName[cat] ?? cat) : vertaald;
}
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "mk.intro")} title={`${t(taal, "mk.titel")} — Stichting Gema Rasa`}>
  <PageHero
    sleutel="menukaart"
    eyebrow={t(taal, "mk.eyebrow")}
    titel={t(taal, "mk.titel")}
    tekst={t(taal, "mk.intro")}
    foto="/assets/perf-wayang.jpg"
  />

  <!-- MENUKAART -->
  <section class="block" id="menukaart">
    <div class="wrap">
      {uitgelicht.length > 0 && (
      <Fragment>
      <div class="section-head">
        <span class="kicker">{t(taal, "mk.topKicker")}</span>
        <h2>{t(taal, "mk.topTitel")}</h2>
        <p>{t(taal, "mk.topTekst")}</p>
      </div>
      <div class="grid" id="grid">
        {uitgelicht.map((i) => (
          <article class="card" data-cat={i.cat}>
            {/*
              Bovenaan de kaart staat beeld over de volle breedte. Een
              menukaart van alleen tekstblokken laat je lezen wat je krijgt,
              maar niet zien -- en bij een optreden is juist het zien de
              verkoop.

              Is er nog geen foto bij dit programma gezet, dan komt er een vlak
              met het batikmotief in plaats van zomaar een andere foto. Zo
              staat er nooit een beeld boven dat niet bij het programma hoort,
              en ziet een kaart zonder foto eruit als een keuze in plaats van
              als een gat. Zodra er wel een foto in staat, wint die.

              `alt` blijft leeg omdat het beeld versiert en de naam van het
              programma er al in woorden onder staat; een schermlezer zou hem
              anders twee keer voorlezen. Het vlak is om dezelfde reden
              aria-hidden: er valt niets aan voor te lezen.
            */}
            {i.foto ? (
              <div class="kaart-foto">
                <img src={i.foto} alt="" loading="lazy" decoding="async" width="660" height="372" />
              </div>
            ) : (
              <div class="kaart-vlak" aria-hidden="true"></div>
            )}
            {i.badge && <span class="badge">{i.label}</span>}
            <span class="cat">{catName[i.cat]}</span>
            <h3>{i.name}</h3>
            <p class="desc">{i.desc}</p>
            <span class="perfect">✦ {i.perfect}</span>
            <div class="foot"><span class="dur">⏱ {i.dur}</span><span class="price">{i.price}</span></div>
            <a
              class="kaart-knop"
              href={`${pad(taal, '/boeking')}?programma=${i.slug}`}
              aria-label={`${t(taal, "mk.kaartKnop")}: ${i.name}`}
            >{t(taal, "mk.kaartKnop")} →</a>
          </article>
        ))}
      </div>
      </Fragment>
      )}

      <div class="section-head alles-head">
        <span class="kicker">{t(taal, "mk.allesKicker")}</span>
        <h2>{t(taal, "mk.allesTitel")}</h2>
        <p>{t(taal, "mk.allesTekst")}</p>
      </div>

      {groepen.map((g) => (
        <section class="groep">
          <h3 class="groep-kop">
            {groepNaam(g.cat)}
            <span class="groep-telling">{g.items.length}</span>
          </h3>
          {samengevoegd.includes(g.cat) && g.items.length > 1 ? (
            <div class="rij rij-samen">
              <div class="rij-naam">
                <span class="rij-titel">{t(taal, "mk.samenTitel")}</span>
                <span class="rij-voor">{t(taal, "mk.samenTekst")}</span>
              </div>
              <span class="rij-dur">{duurBereik(g.items)}</span>
              <span class="rij-prijs">{prijsBereik(g.items)}</span>
              <div class="onderwerpen">
                <span class="onderwerpen-kop">{t(taal, "mk.samenKies")}</span>
                <ul>
                  {g.items.map((i) => (
                    <li>
                      <a
                        href={`${pad(taal, '/boeking')}?programma=${i.slug}`}
                        aria-label={`${t(taal, "mk.kaartKnop")}: ${i.name}`}
                      >
                        <span class="ond-naam">{i.name}</span>
                        <span class="ond-prijs">{i.price}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <ul class="rijen">
              {g.items.map((i) => (
                <li class="rij">
                  <div class="rij-naam">
                    <span class="rij-titel">{i.name}</span>
                    {i.perfect && <span class="rij-voor">{i.perfect}</span>}
                  </div>
                  <span class="rij-dur">{i.dur}</span>
                  <span class="rij-prijs">{i.price}</span>
                  <a
                    class="rij-knop"
                    href={`${pad(taal, '/boeking')}?programma=${i.slug}`}
                    aria-label={`${t(taal, "mk.kaartKnop")}: ${i.name}`}
                  >{t(taal, "mk.rijKnop")} →</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
  </section>

  <!-- VIDEO -->
  {videos.length > 0 && (
  <section class="block video-sec" id="video">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "mk.videoKicker")}</span>
        <h2>{t(taal, "mk.videoTitel")}</h2>
        <p>{t(taal, "mk.videoTekst")}</p>
      </div>
      <div class="vgrid">
        {videos.map((v) => (
          <div class="vcard" data-yt={v.yt}>
            <div class="poster" style={`background-image:url('${v.poster}')`}></div>
            <div class="play"></div>
            <div class="vlabel"><small>{v.kicker}</small><h4>{v.title}</h4></div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  {/*
    Wat de prijs bepaalt.

    Staat hier, direct onder de prijzen, omdat de vragen hierover anders per
    mail terugkomen: zit de btw erbij, komen er reiskosten bij, met hoeveel
    mensen komen jullie, wat moet ik zelf regelen. Vier mails heen en weer
    voor er een offerte ligt.

    Het btw-tarief staat er bewust niet bij: de prijzen zijn richtprijzen en
    het tarief hangt af van het soort programma, dus dat hoort op de offerte
    en niet op een pagina waar het stilletjes verkeerd kan komen te staan.
  */}
  <section class="block prijsuitleg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "mk.prijsKicker")}</span>
        <h2>{t(taal, "mk.prijsTitel")}</h2>
        <p>{t(taal, "mk.prijsIntro")}</p>
      </div>

      <div class="prijsgrid">
        <div class="prijskaart hoofd">
          <h3>{t(taal, "mk.prijsSetKop")}</h3>
          <p>{t(taal, "mk.prijsSetTekst")}</p>
        </div>

        <div class="prijskaart">
          <h3>{t(taal, "mk.prijsErbijKop")}</h3>
          <ul>
            <li>{t(taal, "mk.prijsErbij1")}</li>
            <li>{t(taal, "mk.prijsErbij2")}</li>
          </ul>
        </div>

        <div class="prijskaart">
          <h3>{t(taal, "mk.prijsJijKop")}</h3>
          <ul>
            <li>{t(taal, "mk.prijsJij1")}</li>
            <li>{t(taal, "mk.prijsJij2")}</li>
            <li>{t(taal, "mk.prijsJij3")}</li>
            <li>{t(taal, "mk.prijsJij4")}</li>
          </ul>
        </div>
      </div>

      <p class="prijsslot">{t(taal, "mk.prijsSlot")}</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-inner">
      <h2>{t(taal, "mk.ctaTitel")}</h2>
      <p>{t(taal, "mk.ctaTekst")}</p>
      <a class="btn" href={pad(taal, "/boeking")}>{t(taal, "mk.ctaKnop")}</a>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('.vcard[data-yt]').forEach((card) => {
    card.addEventListener('click', () => {
      if (card.classList.contains('playing')) return;
      const id = card.dataset.yt;
      const ifr = document.createElement('iframe');
      ifr.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0&modestbranding=1';
      ifr.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      ifr.allowFullscreen = true;
      ifr.loading = 'lazy';
      card.appendChild(ifr);
      card.classList.add('playing');
    });
  });
</script>

<style>
  /* Het blok dat uitlegt wat de prijs bepaalt.
     Rustiger dan de kaarten erboven: geen gekleurde balk, geen schaduw. Het
     is naslag, geen aanbod -- wie het niet nodig heeft moet eroverheen kunnen
     lezen. */
  .prijsuitleg { background: #efeee2; }
  .prijsuitleg .section-head p { max-width: 640px; }

  .prijsgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 20px;
    margin-top: 28px;
  }

  .prijskaart {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px 26px;
  }
  .prijskaart h3 {
    margin: 0 0 12px;
    font-size: 19px;
    font-weight: 600;
    color: var(--primary-dark);
    line-height: 1.2;
  }
  .prijskaart p {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 14.5px;
    line-height: 1.7;
    color: #4a4a4a;
  }
  .prijskaart ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .prijskaart li {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 14.5px;
    line-height: 1.6;
    color: #4a4a4a;
  }

  /* De vraag die de prijs het meest bepaalt, krijgt het meeste gewicht. */
  .prijskaart.hoofd {
    border-left: 4px solid var(--secondary);
  }
  .prijskaart.hoofd h3 { font-size: 21px; }

  .prijsslot {
    margin: 22px 0 0;
    max-width: 640px;
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 14px;
    line-height: 1.7;
    color: var(--gray);
  }
  /* ---------- de compacte regels per soort ---------- */

  /* Lucht tussen het uitgelichte blok en de volledige lijst, zodat het twee
     stappen worden in plaats van één lange brij. */
  .alles-head { margin-top: 76px; }

  .groep { margin-top: 40px; }

  .groep-kop {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--line);
    font-size: 19px;
    font-weight: 700;
    color: var(--primary-dark);
  }
  /* Het aantal erbij, zodat zichtbaar is hoe groot een groep is voordat je
     hem doorleest. */
  .groep-telling {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 13px;
    color: var(--gray);
  }

  .rijen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Naam en doelgroep links, dan de duur, dan de prijs, dan de knop. De twee
     vaste breedtes houden de duur- en prijskolom over alle regels op één lijn,
     zodat je ze van boven naar beneden kunt vergelijken -- dat is precies waar
     een lijst beter in is dan losse kaarten. */
  .rij {
    display: grid;
    grid-template-columns: 1fr 104px 152px auto;
    align-items: center;
    gap: 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 14px 18px;
    transition: border-color .18s, box-shadow .2s;
  }
  .rij:hover { border-color: rgba(19,102,61,.4); box-shadow: 0 8px 24px rgba(9,53,31,.07); }

  .rij-naam { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .rij-titel { font-size: 17.5px; font-weight: 600; color: var(--primary-dark); line-height: 1.2; }
  .rij-voor {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 12.5px;
    color: var(--gray);
  }
  .rij-dur {
    font-family: 'Poppins', sans-serif;
    font-size: 12.5px;
    color: var(--gray);
    text-align: right;
  }
  .rij-prijs { font-weight: 700; font-size: 18px; color: var(--secondary); text-align: right; }

  .rij-knop {
    font-family: 'Poppins', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 8px;
    text-decoration: none;
    border: 1.5px solid var(--secondary);
    color: var(--secondary);
    background: #fff;
    white-space: nowrap;
    transition: background .18s, color .18s;
  }
  .rij:hover .rij-knop,
  .rij-knop:hover,
  .rij-knop:focus-visible { background: var(--secondary); color: #fff; }

  /* Op een telefoon is er geen ruimte voor vier kolommen: de naam neemt de
     hele breedte, duur en prijs komen eronder tegenover elkaar, en de knop
     wordt een volle balk -- groot genoeg om met een duim te raken. */
  @media (max-width: 760px) {
    .rij { grid-template-columns: 1fr auto; gap: 10px 14px; }
    .rij-naam { grid-column: 1 / -1; }
    .rij-dur { text-align: left; }
    .rij-knop { grid-column: 1 / -1; text-align: center; }
  }
  /* ---------- de samengevoegde groep ---------- */

  /* Eén regel die voor zes onderwerpen staat, dus hoger dan de andere regels:
     bovenin naam, duur en prijs net als elders, daaronder de onderwerpen. Er
     staat geen knop rechts -- de onderwerpen zijn zelf de knoppen, en twee
     soorten knoppen in één regel maakt onduidelijk waar je heen gaat. */
  .rij-samen {
    grid-template-columns: 1fr 104px 152px;
    row-gap: 16px;
    padding: 18px 18px 16px;
    align-items: start;
  }
  /* De regel als geheel is niet aanklikbaar, dus hij moet ook niet oplichten
     alsof dat wel zo is. */
  .rij-samen:hover { border-color: var(--line); box-shadow: none; }
  .rij-samen .rij-voor { max-width: 52ch; line-height: 1.55; }
  .rij-samen .rij-dur,
  .rij-samen .rij-prijs { padding-top: 3px; }

  .onderwerpen {
    grid-column: 1 / -1;
    padding-top: 14px;
    border-top: 1px dashed var(--line);
  }
  .onderwerpen-kop {
    display: block;
    margin-bottom: 10px;
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--orange-ink);
  }
  .onderwerpen ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(330px, 100%), 1fr));
    gap: 8px;
  }
  /* Crème op wit, zodat de onderwerpen zichtbaar bij elkaar horen en toch als
     losse keuzes lezen. Bij aanwijzen draait dat om: wit met een groene rand. */
  .onderwerpen a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    height: 100%;
    padding: 11px 14px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 8px;
    transition: background .18s, border-color .18s;
  }
  .onderwerpen a:hover,
  .onderwerpen a:focus-visible { background: #fff; border-color: var(--secondary); }
  .ond-naam { font-size: 15px; font-weight: 600; color: var(--primary-dark); line-height: 1.25; }
  .ond-prijs {
    font-family: 'Poppins', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--secondary);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .rij-samen { grid-template-columns: 1fr auto; }
    .rij-samen .rij-dur { text-align: left; }
  }
</style>

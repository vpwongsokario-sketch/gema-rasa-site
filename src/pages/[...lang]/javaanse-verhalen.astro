      {
        v: 'Apakah cerita Jawa sudah dituliskan?',
        a: 'Wiracarita besarnya sudah, dalam versi yang tak terhitung. Kisah keluarganya sering belum. Dari para pekerja kontrak Jawa yang berangkat ke Suriname antara 1890 dan 1939 tercatat dengan teliti kapal mana yang mereka tumpangi, tetapi apa yang mereka alami dan tuturkan tidak tercatat di mana pun. Karena itu Stichting Gema Rasa merekamnya, antara lain dalam seri dokumenter Onzichtbare Verhalen.',
      },
      {
        v: 'Apa beda cerita Jawa dan wayang?',
        a: 'Wayang adalah bentuk pementasan ceritanya: teater boneka dengan dalang dan gamelan. Ceritanya sendiri lebih tua daripada bentuk itu dan juga dituturkan, ditarikan atau ditembangkan tanpa boneka.',
      },
      {
        v: 'Bisakah memesan seorang pencerita?',
        a: 'Bisa. Kami menuturkan empat kisah berdurasi tiga puluh sampai empat puluh lima menit, masing-masing mulai € 440: De Overtocht, De Stille Kracht van de Javaan, Van Stilte naar Stem, dan Rituelen & Erfenis. Semuanya bisa dipesan untuk peringatan, sekolah, museum dan organisasi, berdiri sendiri atau digabung dengan musik atau lokakarya. Penuturannya dalam bahasa Belanda.',
      },
    ],
  },
};

const c = INHOUD[taal] ?? INHOUD.nl;
const epen2Html = c.epen2.replace('%WAYANG%', pad(taal, '/wat-is-wayang'));
const stil3Html = c.stil3.replace('%MAGAZINE%', pad(taal, '/suwara-jawa'));
---

<Base taal={taal} title={c.titel} description={c.omschrijving}>
  <PageHero
    sleutel="javaanse-verhalen"
    eyebrow={c.eyebrow}
    titel={c.kop}
    tekst={c.heroTekst}
    foto="/assets/perf-expo.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="prose">
        <p class="lead" set:html={c.lead} />
        <p>{c.intro2}</p>
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.epenKicker}</span>
        <h2>{c.epenKop}</h2>
      </div>
      <div class="prose">
        <p>{c.epen1}</p>
        <p set:html={epen2Html} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.volksKicker}</span>
        <h2>{c.volksKop}</h2>
      </div>
      <div class="prose">
        <p set:html={c.volks1} />
        <p>{c.volks2}</p>
        <p>{c.volks3}</p>
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.stilKicker}</span>
        <h2>{c.stilKop}</h2>
      </div>
      <div class="prose">
        <p>{c.stil1}</p>
        <p>{c.stil2}</p>
        <p set:html={stil3Html} />
      </div>
      <p class="gamknoppen">
        <a class="btn" href={pad(taal, '/surinaams-javaans')}>{c.knopSurjav}</a>
        <a class="btn" href={pad(taal, '/videos')}>{c.knopVideos}</a>
      </p>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.boekenKicker}</span>
        <h2>{c.boekenKop}</h2>
      </div>
      <div class="prose">
        <p>{c.boekenIntro}</p>
      </div>
      <div class="tabelwrap">
        <table class="gamtabel">
          <thead>
            <tr><th>{c.tabelVerhaal}</th><th>{c.tabelWaarover}</th><th>{c.tabelDuur}</th></tr>
          </thead>
          <tbody>
            {c.eigen.map((e) => (
              <tr>
                <td><strong>{e.titel}</strong></td>
                <td class="jw">{e.waarover}</td>
                <td>{e.duur}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="gamknoppen">
        <a class="btn gold" href={pad(taal, '/menukaart')}>{c.knopBoeken}</a>
        <a class="btn" href={pad(taal, '/wat-is-wayang')}>{c.knopWayang}</a>
      </p>
    </div>
  </section>

  <Vragen kicker={c.vragenKicker} titel={c.vragenKop} vragen={c.vragen} />
</Base>

<style>
  .tabelwrap { overflow-x: auto; margin-top: 8px; }
  .gamtabel { border-collapse: collapse; width: 100%; max-width: 760px; font-size: 15px; }
  .gamtabel th, .gamtabel td { text-align: left; padding: 11px 16px 11px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .gamtabel th { font-weight: 600; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .gamtabel .jw { color: var(--muted); }
  .gamknoppen { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>

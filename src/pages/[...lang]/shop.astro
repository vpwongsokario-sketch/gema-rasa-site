---
import { taalPaden, t, pad } from '../../i18n/index.ts';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('shop');
import { getPaginaSeo } from '../../lib/sanity.ts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "sh.intro")} title={`${t(taal, "sh.titel")} — Stichting Gema Rasa`}>
  <PageHero
    sleutel="shop"
    eyebrow={t(taal, "sh.eyebrow")}
    titel={t(taal, "sh.titel")}
    tekst={t(taal, "sh.intro")}
    foto="/assets/perf4.jpg"
  />

  {taal === 'nl' && (
    <section class="block vervolg shop-product">
      <div class="wrap">
        <a class="product-kaart" href="https://winkel.stichtinggemarasa.com/weton">
          <span class="kicker">Nieuw · persoonlijk cadeau</span>
          <h2>Jouw weton als print</h2>
          <p>Vul een geboortedatum, -tijd en -plaats in en zie direct je Javaanse weton: dag, pasaran en neptu. Gedrukt in Europa en thuisbezorgd, vanaf € 29,95.</p>
          <span class="btn gold">Maak je weton-print</span>
        </a>
      </div>
    </section>
  )}

  <section class="block">
    <div class="wrap">
      <div class="prose">
        <p class="lead">{t(taal, "sh.lead")}</p>
        <p>{t(taal, "sh.p1")}</p>
        <p><a class="btn gold" href={pad(taal, "/contact")}>{t(taal, "sh.knop")}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .product-kaart{display:flex;flex-direction:column;gap:12px;max-width:720px;padding:32px;border-radius:16px;background:var(--primary-dark);color:var(--cream);text-decoration:none}
  .product-kaart h2{margin:0;font-size:clamp(28px,4vw,40px);color:var(--primary)}
  .product-kaart p{margin:0;font-family:'Poppins',sans-serif;font-weight:300;max-width:56ch}
  .product-kaart .kicker{font-family:'Poppins';font-weight:600;letter-spacing:.13em;text-transform:uppercase;font-size:12.5px;color:var(--orange)}
  .product-kaart .btn{align-self:flex-start}
</style>

---
import { taalPaden, t, pad } from '../../i18n/index.ts';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
import { getPaginaSeo, cdnBeeld } from '../../lib/sanity.ts';
import { getWinkelProducten, euro } from '../../lib/winkel.ts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

const paginaSeo = await getPaginaSeo('shop');

/**
 * De producten komen uit de winkel zelf en niet uit deze site.
 *
 * Zie src/lib/winkel.ts. Komt er niets terug, dan blijft de rest van de
 * pagina gewoon staan en wijst hij door naar de winkel.
 */
const producten = await getWinkelProducten();
const WINKEL = 'https://winkel.stichtinggemarasa.com';
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "sh.intro")} title={`${t(taal, "sh.titel")} — Stichting Gema Rasa`}>
  <PageHero
    sleutel="shop"
    eyebrow={t(taal, "sh.eyebrow")}
    titel={t(taal, "sh.titel")}
    tekst={t(taal, "sh.intro")}
    foto="/assets/perf4.jpg"
  />

  {producten.length > 0 && (
    <section class="block">
      <div class="wrap">
        <p class="lead shop-lead">{t(taal, "sh.lead")}</p>

        <div class="grid shop-grid">
          {producten.map((p) => (
            <a class="card product" href={p.adres}>
              {p.beeld && (
                <span class="product-beeld">
                  <img src={cdnBeeld(p.beeld, 640)} alt={p.naam} loading="lazy" width="320" height="440" />
                </span>
              )}
              <h3>{p.naam}</h3>
              {p.ondertitel && <p class="desc">{p.ondertitel}</p>}
              {p.labels.length > 0 && (
                <span class="product-labels">{p.labels.join(' · ')}</span>
              )}
              <span class="foot">
                <span class="price">
                  {p.vanaf && <small>{t(taal, "sh.vanaf")} </small>}{euro(p.prijs)}
                </span>
                <span class="dur">{t(taal, "sh.bekijk")} →</span>
              </span>
            </a>
          ))}
        </div>

        <p class="shop-naar-winkel">
          <a class="btn gold" href={`${WINKEL}/winkel`}>{t(taal, "sh.naarwinkel")}</a>
        </p>
      </div>
    </section>
  )}

  {producten.length === 0 && (
    <section class="block">
      <div class="wrap">
        <div class="prose">
          <p class="lead">{t(taal, "sh.lead")}</p>
          <p><a class="btn gold" href={`${WINKEL}/winkel`}>{t(taal, "sh.naarwinkel")}</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="block vervolg">
    <div class="wrap">
      <div class="prose">
        <p>{t(taal, "sh.p1")}</p>
        <p><a class="btn ghost" href={pad(taal, "/contact")}>{t(taal, "sh.knop")}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .shop-lead{max-width:62ch;margin:0 0 28px}

  /* De kaarten zijn links; de hele kaart is aanklikbaar. */
  .shop-grid .product{text-decoration:none;color:inherit}

  /**
   * Het beeld bovenaan, met een vaste verhouding.
   *
   * De omslagen lopen uiteen -- een kalender is staand, een doosje kaarten
   * bijna vierkant. Zonder vaste hoogte staan de titels onder elkaar op zeven
   * verschillende hoogtes en valt het rooster uit elkaar.
   */
  .product-beeld{
    display:block;margin:-28px -28px 18px;background:var(--cream);
    border-bottom:1px solid var(--line);
  }
  .product-beeld img{
    display:block;width:100%;height:230px;object-fit:contain;padding:18px 18px 14px;
  }
  .product h3{margin-top:0}
  .product-labels{
    display:block;margin-top:12px;font-family:'Poppins',sans-serif;font-size:12.5px;
    color:var(--gray);font-weight:300;
  }
  .product .foot{width:100%}
  .product .price small{font-size:13px;font-weight:500;color:var(--gray)}

  .shop-naar-winkel{margin-top:32px}
</style>

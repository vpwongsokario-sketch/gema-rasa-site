const c = INHOUD[taal] ?? INHOUD.nl;
const bronHtml = c.bron.replace('%URL%', UNESCO);
---

<Base taal={taal} title={c.titel} description={c.omschrijving}>
  <PageHero
    sleutel="wat-is-wayang"
    eyebrow={c.eyebrow}
    titel={c.kop}
    tekst={c.heroTekst}
    foto="/assets/perf-wayang.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="prose">
        <p class="lead" set:html={c.lead} />
        <p>{c.unesco}</p>
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">

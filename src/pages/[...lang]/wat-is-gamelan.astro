    knopCursus: 'Lihat kursus gamelan →',
    knopNederland: 'Gamelan di Belanda',
    knopOrkest: 'Orkes gamelan kami',

    vragenKicker: 'Pertanyaan yang sering diajukan',
    vragenKop: 'Tentang gamelan',
    bronKop: 'Sumber',
    bron:
      'Teori pada halaman ini mengikuti Sumarsam, <em>Introduction, Theory, and Analysis: Javanese Gamelan</em> (Middletown CT, 2023), yang disediakan cuma-cuma oleh penulisnya sendiri. <a href="%BRON%" rel="noopener" target="_blank">Bukunya bisa dibaca di sini</a>. Istilah melodi batin, irama dan embat berasal dari sana.',

    groepen: [
      {
        rol: 'Melodi',
        wat: 'Membawa dan menggarap melodi',
        instrumenten: 'slenthem, demung, saron, peking, bonang, rebab, gendèr, gambang, suling',
      },
      { rol: 'Waktu', wat: 'Menentukan tempo, peralihan dan akhir', instrumenten: 'kendhang' },
      {
        rol: 'Struktur',
        wat: 'Menandai posisi dalam siklus',
        instrumenten: 'gong ageng, kenong, kempul, kethuk, kempyang',
      },
    ],

    vragen: [
      {
        v: 'Apa itu gamelan?',
        a: 'Gamelan adalah orkes dari Jawa dan Bali: satu perangkat tetap yang sebagian besar terdiri atas instrumen pukul perunggu — gong, metalofon dan kendhang — dilengkapi alat gesek, tiup dan vokal. Instrumennya dibuat dan dilaras sebagai satu kesatuan, jadi sebuah gamelan adalah satu instrumen yang dimainkan bersama oleh sekelompok orang.',
      },
      {
        v: 'Apa arti kata gamelan?',
        a: 'Berasal dari kata Jawa "gamel", memukul. Musiknya sendiri dalam bahasa Jawa disebut karawitan.',
      },
      {
        v: 'Berapa orang bermain dalam satu orkes gamelan?',
        a: 'Tergantung gendhing dan perangkatnya. Instrumennya terbagi atas tiga fungsi: yang membawa dan menggarap melodi, kendhang yang mengatur waktu, dan gong-gong yang menandai struktur siklus.',
      },
      {
        v: 'Apa itu sléndro dan pélog?',
        a: 'Dua laras gamelan Jawa. Sléndro memiliki lima nada dengan jarak yang hampir sama; pélog memiliki tujuh nada dengan jarak tidak sama, dan dalam praktiknya tiga tangga nada lima nada dipakai darinya. Banyak perangkat gamelan terdiri atas dua orkes lengkap, satu untuk tiap laras.',
      },
      {
        v: 'Apakah dua gamelan terdengar sama?',
        a: 'Tidak. Tidak ada laras baku seperti 440 hertz di Barat. Setiap gamelan punya laras dan warna bunyinya sendiri, disebut embat. Karena itu instrumen dari dua gamelan berbeda tidak bisa dipertukarkan.',
      },
      {
        v: 'Apa itu irama?',
        a: 'Irama bukan ritme melainkan kerapatan: berapa banyak nada yang dimainkan instrumen garap untuk satu nada balungan. Pada setiap tingkat jumlah itu berlipat dua, dari 1 pada lancar sampai 16 pada rangkep. Gendhingnya menjadi bukan hanya lebih lambat, tetapi juga lebih padat.',
      },
      {
        v: 'Apa beda gamelan Jawa dan gamelan Bali?',
        a: 'Keduanya tradisi yang berbeda. Gamelan Bali dikenal karena peralihannya yang cepat dan tajam; musik keraton Jawa umumnya lebih tenang dan berlapis. Di dalam Jawa pun ada perbedaan, terutama antara gaya Solo dan Yogyakarta, yang berakar pada terbelahnya Kerajaan Mataram pada 1755.',
      },
      {
        v: 'Bisakah belajar gamelan tanpa bisa membaca not?',
        a: 'Bisa. Gamelan adalah tradisi lisan: mendengarkan dan menirukan adalah inti belajarnya. Notasi angka kepatihan memang ada, tetapi itu alat bantu ingatan, bukan musiknya sendiri.',
      },
    ],
  },
};

const c = INHOUD[taal] ?? INHOUD.nl;

/* Irama: de vijf niveaus van dichtheid. De namen zijn Javaans en blijven gelijk. */
const irama = [
  { naam: 'Lancar',   slagen: '1' },
  { naam: 'Tanggung', slagen: '2' },
  { naam: 'Dadi',     slagen: '4' },
  { naam: 'Wilet',    slagen: '8' },
  { naam: 'Rangkep',  slagen: '16' },
];

const lerenHtml = c.leren3.replace('%GAMELANNL%', pad(taal, '/gamelan-in-nederland'));
const bronHtml = c.bron.replace('%BRON%', BRON);
---
<Base taal={taal} title={c.titel} description={c.omschrijving}>
  <PageHero
    sleutel="wat-is-gamelan"
    eyebrow={c.eyebrow}
    titel={c.kop}
    tekst={c.heroTekst}
    foto="/assets/perf-gamelan.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="prose">
        <p class="lead" set:html={c.lead} />
        <p set:html={c.intro2} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.opbouwKicker}</span>
        <h2>{c.opbouwKop}</h2>
      </div>
      <div class="prose">
        <p>{c.opbouwIntro}</p>
      </div>
      <div class="tabelwrap">
        <table class="gamtabel">
          <thead>
            <tr><th>{c.tabelFunctie}</th><th>{c.tabelWat}</th><th>{c.tabelInstrumenten}</th></tr>
          </thead>
          <tbody>
            {c.groepen.map((g) => (
              <tr>
                <td><strong>{g.rol}</strong></td>
                <td>{g.wat}</td>
                <td class="jw">{g.instrumenten}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose">
        <p set:html={c.kendhang} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.stemmingKicker}</span>
        <h2>{c.stemmingKop}</h2>
      </div>
      <div class="prose">
        <p set:html={c.stemming1} />
        <p set:html={c.stemming2} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.kernKicker}</span>
        <h2>{c.kernKop}</h2>
      </div>
      <div class="prose">
        <p set:html={c.kern1} />
        <p set:html={c.kern2} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.iramaKicker}</span>
        <h2>{c.iramaKop}</h2>
      </div>
      <div class="prose">
        <p set:html={c.iramaTekst} />
      </div>
      <div class="tabelwrap">
        <table class="gamtabel">
          <thead>
            <tr><th>{c.tabelNiveau}</th><th>{c.tabelSlagen}</th></tr>
          </thead>
          <tbody>
            {irama.map((i) => (
              <tr><td><strong>{i.naam}</strong></td><td>{i.slagen}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.stijlKicker}</span>
        <h2>{c.stijlKop}</h2>
      </div>
      <div class="prose">
        <p>{c.stijl1}</p>
        <p set:html={c.stijl2} />
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{c.lerenKicker}</span>
        <h2>{c.lerenKop}</h2>
      </div>
      <div class="prose">
        <p set:html={c.leren1} />
        <p>{c.leren2}</p>
        <p set:html={lerenHtml} />
      </div>
      <p class="gamknoppen">
        <a class="btn gold" href={pad(taal, '/gamelancursus')}>{c.knopCursus}</a>
        <a class="btn" href={pad(taal, '/gamelan-in-nederland')}>{c.knopNederland}</a>
        <a class="btn" href={pad(taal, '/de-gamelan-groep')}>{c.knopOrkest}</a>
      </p>
    </div>
  </section>

  <Vragen kicker={c.vragenKicker} titel={c.vragenKop} vragen={c.vragen} />

  <section class="block vervolg">
    <div class="wrap">
      <div class="prose bronnen">
        <h3>{c.bronKop}</h3>
        <p set:html={bronHtml} />
      </div>
    </div>
  </section>
</Base>

<style>
  .tabelwrap { overflow-x: auto; margin-top: 8px; }
  .gamtabel { border-collapse: collapse; width: 100%; max-width: 760px; font-size: 15px; }
  .gamtabel th, .gamtabel td { text-align: left; padding: 11px 16px 11px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .gamtabel th { font-weight: 600; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .gamtabel .jw { color: var(--muted); }
  .gamknoppen { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .bronnen { font-size: 15px; color: var(--muted); }
  .bronnen h3 { font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
</style>

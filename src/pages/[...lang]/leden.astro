---
import { taalPaden, t, pad } from '../../i18n/index.ts';
import Persoon from '../../components/Persoon.astro';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('leden');
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getLeden , getPaginaSeo} from '../../lib/sanity.ts';
const { bestuur, gamelan, dans, vrijwilligers } = await getLeden(taal);

// Initialen als er nog geen foto is geüpload
const initialen = (naam = '') =>
  naam.split(/[\s-]+/).filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "ld.intro")} title={`${t(taal, "ld.titel")} — Stichting Gema Rasa`}>
  <PageHero
    sleutel="leden"
    eyebrow={t(taal, "ld.eyebrow")}
    titel={t(taal, "ld.titel")}
    tekst={t(taal, "ld.intro")}
    foto="/assets/perf-gamelan.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "ld.bestuurKicker")}</span>
        <h2>{t(taal, "ld.bestuurTitel")}</h2>
      </div>
      <div class="team-grid">
        {bestuur.map((m) => (
          <div class="member board">
            {m.foto
              ? <img class="avatar" src={m.foto} alt={m.naam} loading="lazy" />
              : <div class="avatar-fallback" aria-hidden="true">{initialen(m.naam)}</div>}
            <div class="naam">{m.naam}</div>
            <div class="rol">{m.rol}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "ld.groepKicker")}</span>
        <h2>{t(taal, "ld.groepTitel")}</h2>
        <p>{t(taal, "ld.groepTekst")}</p>
      </div>
      <div class="team-grid">
        {gamelan.map((m) => <Persoon m={m} taal={taal} />)}
        <div class="member" style="border-style:dashed;display:flex;flex-direction:column;justify-content:center">
          <div class="naam">{t(taal, "ld.jij")}</div>
          <div class="rol">{t(taal, "ld.jijRol")}</div>
        </div>
      </div>
    </div>
  </section>

  {/*
    Dansgroep en vrijwilligers apart.

    Stonden eerder in één lijst onder de kop van het orkest, met "De musici &
    vrijwilligers" erboven. Vier dansers werden daardoor gepresenteerd als
    leden van de gamelangroep, en wie alleen meehelpt stond tussen de musici.
    Drie groepen die iets anders doen horen ook drie koppen te hebben.
  */}
  {dans.length > 0 && (
    <section class="block vervolg">
      <div class="wrap">
        <div class="section-head">
          <span class="kicker">{t(taal, "ld.dansKicker")}</span>
          <h2>{t(taal, "ld.dansTitel")}</h2>
          <p>{t(taal, "ld.dansTekst")}</p>
        </div>
        <div class="team-grid">
          {dans.map((m) => <Persoon m={m} taal={taal} />)}
        </div>
      </div>
    </section>
  )}

  {vrijwilligers.length > 0 && (
    <section class="block vervolg">
      <div class="wrap">
        <div class="section-head">
          <span class="kicker">{t(taal, "ld.vrijKicker")}</span>
          <h2>{t(taal, "ld.vrijTitel")}</h2>
          <p>{t(taal, "ld.vrijTekst")}</p>
        </div>
        <div class="team-grid">
          {vrijwilligers.map((m) => <Persoon m={m} taal={taal} />)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "ld.faqKicker")}</span>
        <h2>{t(taal, "ld.faqTitel")}</h2>
      </div>
      <div class="prose">
        <h3>{t(taal, "ld.faq1V")}</h3>
        <p>{t(taal, "ld.faq1A")}</p>
        <h3>{t(taal, "ld.faq2V")}</h3>
        <p>{t(taal, "ld.faq2A")}</p>
      </div>
    </div>
  </section>
</Base>

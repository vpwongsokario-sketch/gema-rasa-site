---
import { taalPaden, t, pad } from '../../i18n/index.ts';
import Persoon from '../../components/Persoon.astro';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('leden');
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getLeden , getPaginaSeo} from '../../lib/sanity.ts';
const { bestuur, gamelan, dans, vrijwilligers } = await getLeden(taal);
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "ld.intro")} title={`${t(taal, "ld.titel")} — Stichting Gema Rasa`}>
  <PageHero
    sleutel="leden"
    eyebrow={t(taal, "ld.eyebrow")}
    titel={t(taal, "ld.titel")}
    tekst={t(taal, "ld.intro")}
    foto="/assets/perf-gamelan.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "ld.bestuurKicker")}</span>
        <h2>{t(taal, "ld.bestuurTitel")}</h2>
      </div>
      <div class="team-grid">
        {/* Hetzelfde kaartje als bij de andere blokken, met bestuur={true} voor
            de donkere variant. Stond hier eerder met de hand uitgeschreven, en
            daardoor kon een bestuurslid niet omdraaien. */}
        {bestuur.map((m) => <Persoon m={m} taal={taal} bestuur={true} />)}
      </div>
    </div>
  </section>

  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "ld.groepKicker")}</span>
        <h2>{t(taal, "ld.groepTitel")}</h2>
        <p>{t(taal, "ld.groepTekst")}</p>
      </div>
      <div class="team-grid">
        {/* Zonder het bestuur: die drie spelen ook mee, maar staan al in het
            blok hierboven. Twee keer dezelfde persoon op één pagina leest
            als een fout. Dat ze meespelen staat in hun rol. */}
        {gamelan.filter((m) => !m.rollen?.includes('bestuur')).map((m) => <Persoon m={m} taal={taal} />)}
        <div class="member" style="border-style:dashed;display:flex;flex-direction:column;justify-content:center">
          <div class="naam">{t(taal, "ld.jij")}</div>
          <div class="rol">{t(taal, "ld.jijRol")}</div>
        </div>
      </div>
    </div>
  </section>

  {/*
    Dansgroep en vrijwilligers apart.

    Stonden eerder in één lijst onder de kop van het orkest, met "De musici &
    vrijwilligers" erboven. Vier dansers werden daardoor gepresenteerd als
    leden van de gamelangroep, en wie alleen meehelpt stond tussen de musici.
    Drie groepen die iets anders doen horen ook drie koppen te hebben.
  */}
  {dans.length > 0 && (
    <section class="block vervolg">
      <div class="wrap">
        <div class="section-head">
          <span class="kicker">{t(taal, "ld.dansKicker")}</span>
          <h2>{t(taal, "ld.dansTitel")}</h2>
          <p>{t(taal, "ld.dansTekst")}</p>
        </div>
        <div class="team-grid">
          {dans.map((m) => <Persoon m={m} taal={taal} />)}
        </div>
      </div>
    </section>
  )}

  {vrijwilligers.length > 0 && (
    <section class="block vervolg">
      <div class="wrap">
        <div class="section-head">
          <span class="kicker">{t(taal, "ld.vrijKicker")}</span>
          <h2>{t(taal, "ld.vrijTitel")}</h2>
          <p>{t(taal, "ld.vrijTekst")}</p>
        </div>
        <div class="team-grid">
          {vrijwilligers.map((m) => <Persoon m={m} taal={taal} />)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, "ld.faqKicker")}</span>
        <h2>{t(taal, "ld.faqTitel")}</h2>
      </div>
      <div class="prose">
        <h3>{t(taal, "ld.faq1V")}</h3>
        <p>{t(taal, "ld.faq1A")}</p>
        <h3>{t(taal, "ld.faq2V")}</h3>
        <p>{t(taal, "ld.faq2A")}</p>
      </div>
    </div>
  </section>
<script>
  /*
    Het omdraaien van de ledenkaartjes.

    Eén luisteraar op de pagina in plaats van negenentwintig op de kaartjes:
    minder werk bij het laden, en het werkt ook voor een kaartje dat er later
    bij komt.

    `inert` op de kant die naar achteren staat is geen opsmuk. Zonder dat
    staat de tekst op de achterkant nog steeds in de tabvolgorde en leest een
    schermlezer hem voor terwijl hij niet te zien is -- dan kun je met de
    toetsenbord-tab in een link belanden die voor je ogen achterstevoren hangt.
  */
  (() => {
    const kaarten = document.querySelectorAll('.kaartdraai');
    if (!kaarten.length) return;

    const zet = (kaart, om) => {
      const voor = kaart.querySelector('.kaartdraai-voor');
      const achter = kaart.querySelector('.kaartdraai-achter');
      kaart.classList.toggle('om', om);
      voor.setAttribute('aria-expanded', String(om));
      voor.inert = om;
      achter.inert = !om;
      if (om) kaart.querySelector('.kaartdraai-terug')?.focus();
      else voor.focus();
    };

    kaarten.forEach((kaart) => {
      // Bij het laden staat de achterkant naar achteren.
      kaart.querySelector('.kaartdraai-achter').inert = true;
      kaart.querySelector('.kaartdraai-voor').addEventListener('click', () => zet(kaart, true));
      kaart.querySelector('.kaartdraai-terug').addEventListener('click', () => zet(kaart, false));
      // Escape draait terug, zoals bij elk ding dat opengaat.
      kaart.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && kaart.classList.contains('om')) zet(kaart, false);
      });
    });
  })();
</script>
</Base>

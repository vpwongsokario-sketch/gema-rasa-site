---
import { taalPaden, t, pad } from '../../i18n/index.ts';
export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('videos');
import { getPaginaSeo } from '../../lib/sanity.ts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getVideos, YT_KANAAL_URL } from '../../lib/youtube.ts';
import { socials } from '../../data/content.js';

const videos = await getVideos(taal, 12);

/*
  Videomarkering.

  Zonder dit ziet Google op deze pagina tekst met daarin toevallig wat
  titels; het weet niet dat het video's zijn en kan ze niet als video tonen.
  Elk blok heeft de vier dingen die daarvoor nodig zijn: naam, omschrijving,
  miniatuur en publicatiedatum.

  Alleen als er video's zijn — een leeg blok markering is erger dan geen.
*/
const videoSchema = videos.length
  ? {
      '@context': 'https://schema.org',
      '@graph': videos.map((v) => ({
        '@type': 'VideoObject',
        name: v.titel,
        description: v.beschrijving || v.titel,
        thumbnailUrl: v.thumb,
        uploadDate: v.datum,
        contentUrl: v.url,
        embedUrl: `https://www.youtube.com/embed/${v.id}`,
        publisher: {
          '@type': 'Organization',
          name: 'Stichting Gema Rasa',
          url: 'https://stichtinggemarasa.com',
        },
      })),
    }
  : null;
---
<Base taal={taal} seo={paginaSeo} description={t(taal, "vd.intro")} title={`${t(taal, "vd.titel")} — Stichting Gema Rasa`} jsonld={videoSchema}>
  <PageHero
    sleutel="videos"
    eyebrow={t(taal, "vd.eyebrow")}
    titel={t(taal, "vd.titel")}
    tekst={t(taal, "vd.intro")}
    foto="/assets/perf-gamelan.jpg"
  />

  <!-- VIDEO'S -->
  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">YouTube</span>
        <h2>{t(taal, "vd.videosKop")}</h2>
        <p>{t(taal, "vd.videosTekst")}</p>
      </div>

      {videos.length > 0 ? (
        <div class="videos">
          {/*
           Een link en een echte <img>, geen klikbare div met een
           achtergrondplaatje.

           Zo stond het eerder: de miniatuur was een CSS-achtergrond en de
           video-id zat in data-yt, waar JavaScript hem oppakte. Voor een
           bezoeker werkte dat, maar Google kan een CSS-achtergrond niet als
           videominiatuur gebruiken en zag hier dus wel titels en geen
           video's. Een <a> geeft hem bovendien een adres om naartoe te
           wijzen, en wie met het toetsenbord of een schermlezer werkt kan er
           nu ook bij.

           Het script dat de video in de kaart afspeelt blijft werken: dat
           leest data-yt op het artikel en onderschept de klik.
          */}
          {videos.map((v) => (
            <article class="video" data-yt={v.id}>
              <a class="video-link" href={v.url} target="_blank" rel="noopener">
                <div class="video-thumb">
                  <img src={v.thumb} alt="" loading="lazy" width="480" height="360" />
                  <span class="play" aria-hidden="true"></span>
                </div>
                <div class="video-body">
                  <h3>{v.titel}</h3>
                  {v.datumLabel && <span class="video-datum">{v.datumLabel}</span>}
                </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="ens-leeg">{t(taal, "vd.geenVideos")}</p>
      )}

      <p style="margin-top:34px">
        <a class="btn" href={YT_KANAAL_URL} target="_blank" rel="noopener">{t(taal, "vd.kanaal")}</a>
      </p>
    </div>
  </section>

  <!-- SOCIALS -->
  <section class="block prod rond-boven rond-onder" data-parallax style="padding:70px 0">
    <div class="wrap">
      <div class="ornament op-donker" style="margin-bottom:30px"><span></span></div>
      <div style="text-align:center;max-width:640px;margin:0 auto 34px">
        <h2 style="color:#fff;font-size:clamp(28px,3.6vw,42px);font-weight:700">{t(taal, "vd.socialKop")}</h2>
        <p style="color:rgba(244,243,232,.86);font-family:'Poppins';font-weight:300;margin-top:10px">
          {t(taal, "vd.socialTekst")}
        </p>
      </div>
      <div class="socials">
        {socials.map((s) => (
          <a class="social" href={s.url} target="_blank" rel="noopener" style={`--kleur:${s.kleur}`}>
            <span class="social-naam">{s.naam}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // De YouTube-speler wordt pas geladen als je klikt: sneller én privacyvriendelijk
  document.querySelectorAll<HTMLElement>('.video[data-yt]').forEach((kaart) => {
    kaart.addEventListener('click', () => {
      if (kaart.classList.contains('speelt')) return;
      const id = kaart.dataset.yt;
      const thumb = kaart.querySelector('.video-thumb');
      if (!thumb || !id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.loading = 'lazy';
      thumb.appendChild(frame);
      kaart.classList.add('speelt');
    });
  });
</script>

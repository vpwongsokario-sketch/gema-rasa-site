---
/*
  Echo's van Java op de site van de stichting — bewust kort.

  Uit Search Console: "echo's van java" en varianten zijn samen goed voor 444
  vertoningen in drie maanden, verreweg de grootste zoekvraag die niet onze
  eigen naam is. Daar kwamen 7 kliks uit, op positie 6 tot 7, want er was
  geen pagina over: Google toonde de voorpagina of een oud evenementadres.

  Het festival heeft een eigen domein. Deze pagina probeert dat niet te
  evenaren en herhaalt bewust niet het programma, de prijzen of de
  veelgestelde vragen — dan gaan twee sites om dezelfde zoekvraag vechten en
  verliezen ze allebei. Hij doet één ding: de zoeker opvangen op het domein
  dat al gevonden wordt, vertellen wat het is, en doorsturen.

  Om dezelfde reden staat hier geen Festival- of FAQPage-schema. Die hoort
  bij echosvanjava.nl.
*/
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { taalPaden, t, pad } from '../../i18n/index.ts';

export const getStaticPaths = taalPaden;
const { taal } = Astro.props;

const SITE = 'https://echosvanjava.nl/';
const AFTERMOVIE = 'https://www.youtube.com/watch?v=kSetxVogBBU';
---
<Base
  taal={taal}
  title="Echo's van Java Festival — 19 juni 2027 | Stichting Gema Rasa"
  description="Echo's van Java is het festival van Stichting Gema Rasa over Javaanse en Surinaams-Javaanse cultuur. Zaterdag 19 juni 2027 op Landgoed Vidaa in Bergschenhoek. Alles over het programma en de kaarten staat op echosvanjava.nl."
>
  <PageHero
    sleutel="echos-van-java"
    eyebrow="Ons festival · zaterdag 19 juni 2027"
    titel="Echo's van Java"
    tekst="Een dag Javaanse en Surinaams-Javaanse cultuur op Landgoed Vidaa — gamelan, dans, verhalen, ambacht en eten."
    foto="/assets/perf3.jpg"
  />

  <section class="block">
    <div class="wrap">
      <div class="prose">
        <p class="lead">
          Echo's van Java is het festival van Stichting Gema Rasa: één dag waarop Javaanse cultuur
          uit Nederland, Suriname en Indonesië samenkomt. Gamelan en dans op het podium, verhalen in
          het verhalenhuis, workshops, een expositie, een kindertuin en Javaans eten van makers uit
          de gemeenschap.
        </p>
        <p>
          De volgende editie is op <strong>zaterdag 19 juni 2027</strong>, op Landgoed Vidaa in
          Bergschenhoek. Het festival heeft een eigen site: daar staat het programma, daar koop je
          je kaarten, en daar meld je je aan als standhouder.
        </p>
      </div>

      <p class="ejv-knoppen">
        <a class="btn gold" href={SITE} target="_blank" rel="noopener">Naar echosvanjava.nl →</a>
        <a class="btn" href={AFTERMOVIE} target="_blank" rel="noopener">Bekijk de aftermovie van 2026</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .ejv-knoppen { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
</style>

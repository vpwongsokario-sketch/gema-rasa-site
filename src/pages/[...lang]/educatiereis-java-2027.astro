---
/**
 * Educatiereis Java 2027 — aanbetalingspagina.
 *
 * Bedragen, data en de betaallink staan hieronder in REIS: dat is de enige
 * plek waar je ze hoeft te wijzigen. De teksten staan in src/i18n/java2027.ts.
 */
import { taalPaden, t, pad } from '../../i18n/index.ts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Aankondiging from '../../components/Aankondiging.astro';
import { getPaginaSeo, getReis } from '../../lib/sanity.ts';
import { PROGRAMMA } from '../../data/java2027-programma.ts';

export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('educatiereis-java-2027');

/**
 * De reis en de prijzen komen uit Sanity.
 *
 * Daar staan ze omdat ze van het bestuur zijn en op twee plekken worden
 * gebruikt: hier, en bij het platform dat de betaling aanmaakt. Stonden ze op
 * beide plekken los in de code, dan verandert er ooit eentje en staat er op
 * deze pagina een ander bedrag dan er wordt afgeschreven.
 *
 * Valt Sanity weg, dan gelden de waarden hieronder. Beter een pagina met de
 * bekende prijzen dan een pagina die niet laadt.
 */
const uitSanity = await getReis();

/**
 * Een datum uit Sanity, maar alleen als hij nog niet voorbij is.
 *
 * De sluitingsdatum van de inschrijving staat in Sanity, want hij is van het
 * bestuur. Maar zo'n datum wordt vergeten: tot 15 november 2026 stond er
 * 31 oktober, en dat was al verstreken. Een verlopen datum op de pagina is
 * erger dan geen datum, want dan lijkt de reis gesloten terwijl je je nog
 * kunt aanmelden.
 *
 * Daarom: staat er niets, of staat er iets dat al geweest is, dan geldt de
 * datum in de code hieronder. Zet het bestuur in de Studio een datum in de
 * toekomst, dan wint die.
 */
function nogTeGaan(iso) {
  const tijd = Date.parse(String(iso ?? ''));
  if (!Number.isFinite(tijd)) return null;
  // Tot het eind van die dag: op 31 januari zelf kun je je nog aanmelden.
  return tijd + 24 * 60 * 60 * 1000 > Date.now() ? iso : null;
}

/**
 * De opname van de online presentatie van 14 november 2026.
 *
 * Het bestand is 121 MB en kan niet uit deze map geserveerd worden -- een
 * bestand op Cloudflare Pages mag hoogstens 25 MB zijn. Daarom staat de
 * video op YouTube, net als de andere video's op deze site, en staat hier
 * alleen het id uit de YouTube-link (het stuk na ?v=).
 *
 * Zolang dit leeg is, laat de pagina het blok gewoon weg.
 */
const OPNAME = {
  yt: 'HmLl6vgP5e4',
  duur: '53 min',
};

const REIS = {
  prijsVolwassene: uitSanity?.prijsVolwassene ?? 1000,
  prijsKind: uitSanity?.prijsKind ?? 750,
  kindVanaf: uitSanity?.kindVanaf ?? 3,
  volwassenVanaf: uitSanity?.volwassenVanaf ?? 11,
  vertrek: uitSanity?.vertrek ?? '2027-08-01',
  terug: uitSanity?.terug ?? '2027-08-15',
  reserverenTot: nogTeGaan(uitSanity?.reserverenTot) ?? '2027-01-31',
  open: uitSanity?.open !== false,
  termijnen:
    uitSanity?.termijnen?.length
      ? uitSanity.termijnen
      : [
          { deel: 25, vervaldatum: '2026-10-31' },
          { deel: 37.5, vervaldatum: '2026-12-15' },
          { deel: 37.5, vervaldatum: '2027-05-15' },
        ],
};

/**
 * Het deel dat bij de eerste termijn hoort, en wat dat is voor één volwassene.
 *
 * Op drie plekken nodig: de knop bovenaan, het beginbedrag in het formulier en
 * de knop onderaan. Eén keer uitrekenen, anders staat er ergens een getal dat
 * niet meer klopt als de verdeling verandert.
 */
const eersteDeel = Number(REIS.termijnen[0]?.deel) || 25;
// In centen rekenen en pas daarna delen: bij 37,5% van € 750 gaat het anders
// mis op een halve cent.
const eersteVolwassene = Math.round(REIS.prijsVolwassene * 100 * eersteDeel / 100) / 100;

/**
 * Het dagprogramma in de taal van deze pagina.
 *
 * Nederlands op de Nederlandse pagina, Engels op de andere twee. Het bestuur
 * hoefde geen Indonesische vertaling; Engels is voor een Indonesische lezer
 * bruikbaarder dan Nederlands, en dat is wat er anders zou staan.
 */
const dagTaal: 'nl' | 'en' = taal === 'nl' ? 'nl' : 'en';
const dagen = PROGRAMMA.map((d) => ({
  dag: d.dag,
  weekdag: d.weekdag[dagTaal],
  titel: d.titel[dagTaal],
  regels: d.regels.map((r) => ({ tijd: r.tijd, wat: r[dagTaal], waar: r.waar })),
}));

/** Waar de boeking naartoe gaat. Daar staat de Mollie-sleutel. */
const BOEK_URL = 'https://beheer.stichtinggemarasa.com/api/reis/boeken';

/** Het nummer waarop de stichting bereikbaar is, in het formaat van wa.me. */
const WHATSAPP = '31615045418';
const MAILADRES = 'info@stichtinggemarasa.com';

const loc = { nl: 'nl-NL', en: 'en-GB', id: 'id-ID' }[taal];
const euro = (n: number) =>
  new Intl.NumberFormat(loc, { style: 'currency', currency: 'EUR', minimumFractionDigits: 0 }).format(n);

/**
 * Hetzelfde, maar met de centen erbij.
 *
 * Voor alles wat werkelijk betaald wordt. Een kind kost € 750 en een kwart
 * daarvan is € 187,50; zonder centen staat er € 188 op het scherm en vraagt
 * Mollie € 187,50. Dat verschil ziet een ouder, en dan klopt er iets niet.
 */
const euroCent = (n: number) =>
  new Intl.NumberFormat(loc, { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 }).format(n);
const datum = (iso: string) =>
  new Intl.DateTimeFormat(loc, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));

const reisperiode = `${new Date(REIS.vertrek).getDate()} — ${datum(REIS.terug)}`;

const fotos = ['gamelan', 'koken', 'museum', 'borobudur', 'rivier', 'ramayana'];
const programma = fotos.map((naam, i) => ({
  foto: `/assets/java2027/${naam}.jpg`,
  cat: t(taal, `jv.p${i + 1}cat`),
  titel: t(taal, `jv.p${i + 1}t`),
  tekst: t(taal, `jv.p${i + 1}b`),
}));

/**
 * De termijnen, gerekend vanaf het volwassenentarief.
 *
 * In procenten in Sanity, hier omgerekend naar bedragen. Voor een kind komt er
 * met dezelfde percentages een lager bedrag uit; wat een gezin werkelijk
 * betaalt, rekent het formulier hieronder uit.
 */
let opgeteld = 0;
const termijnen = REIS.termijnen.map((tm: any, i: number) => {
  const bedrag = Math.round((REIS.prijsVolwassene * 100 * (Number(tm.deel) || 0)) / 100) / 100;
  opgeteld += bedrag;
  return {
    kop: t(taal, `jv.t${i + 1}kop`),
    tekst: t(taal, `jv.t${i + 1}b`),
    bedrag: euroCent(bedrag),
    datum: tm.vervaldatum ? datum(tm.vervaldatum) : '',
    deel: Math.round(Number(tm.deel) || 0),
    betaald: Math.round((opgeteld / REIS.prijsVolwassene) * 100),
  };
});

const inbegrepen = [1, 2, 3, 4, 5, 6, 7, 8].map((i) => t(taal, `jv.incl${i}`));
const nietInbegrepen = [1, 2, 3, 4, 5, 6].map((i) => t(taal, `jv.excl${i}`));
const stappen = [1, 2, 3, 4].map((i) => ({ kop: t(taal, `jv.s${i}t`), tekst: t(taal, `jv.s${i}b`) }));
const vragen = [1, 2, 7, 3, 4, 5, 6].map((i) => ({ vraag: t(taal, `jv.v${i}`), antwoord: t(taal, `jv.a${i}`) }));
---

<Base
  taal={taal}
  seo={paginaSeo}
  title={`${t(taal, 'jv.titel')} — Stichting Gema Rasa`}
  description={t(taal, 'jv.intro')}
  ogImage="/assets/java2027/ramayana.jpg"
>
  <PageHero
    sleutel="educatiereis-java-2027"
    eyebrow={t(taal, 'jv.eyebrow')}
    titel={t(taal, 'jv.titel')}
    tekst={t(taal, 'jv.intro')}
    foto="/assets/java2027/hero.jpg"
    positie="center"
  >
    <div class="jv-hero-cta">
      <a class="btn gold" href="#reserveren">{t(taal, 'jv.heroKnop')} — {euroCent(eersteVolwassene)}</a>
      <a class="btn jv-ghost" href="#programma">{t(taal, 'jv.heroKnop2')}</a>
    </div>
  </PageHero>

  <div class="strip">
    <div class="wrap">
      <div><b>{reisperiode}</b> · {t(taal, 'jv.dagen')}</div>
      <div><b>{t(taal, 'jv.plaats')}</b> · Java, Indonesië</div>
      {/*
        Hier stond "Reserveren kan t/m 31 oktober 2026", met de datum vet.
        Dat leest als een sluitingsdatum, en dat is het niet: die datum staat
        er alleen omdat wie zich dit najaar aanmeldt de betaling het ruimst
        kan spreiden. Later aanmelden mag, zolang er plek is. Een harde
        deadline die geen deadline is, kost je juist aanmeldingen van mensen
        die denken dat ze te laat zijn.
      */}
      <div><b>{t(taal, 'jv.plekVrij')}</b> · {t(taal, 'jv.plekUitleg').replace('{datum}', datum(REIS.reserverenTot))}</div>
    </div>
  </div>

  {/*
    De online presentatie over de reis, tot het moment waarop het formulier
    sluit. Zelfde tijdstip als PRESENTATIE.sluit in functions/api/formulier.ts.
  */}
  <Aankondiging
    kicker={t(taal, 'pres.kicker')}
    titel={t(taal, 'pres.titel')}
    tekst={t(taal, 'pres.tekst')}
    knopLabel={t(taal, 'pres.knop')}
    knopUrl={pad(taal, '/presentatie-java-2027')}
    tot="2026-11-14T09:30:00Z"
  />

  {/*
    De opname van de online presentatie.

    Staat bovenaan, want wie de presentatie gemist heeft krijgt hier in een
    klap het hele programma te horen -- dat overtuigt meer dan de tekst
    eronder. Het blok verdwijnt vanzelf zolang er geen video-id staat.

    De afbeelding is een dia uit de opname zelf en staat op onze eigen server.
    Pas als iemand op afspelen klikt wordt YouTube geladen; tot dat moment
    gaat er geen verzoek naar Google en krijgt de bezoeker dus ook geen
    cookie van ze.
  */}
  {OPNAME.yt && (
  <section class="block jv-opname" id="opname">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.opnameKicker')}</span>
        <h2>{t(taal, 'jv.opnameTitel')}</h2>
        <p>{t(taal, 'jv.opnameTekst')}</p>
      </div>
      <button class="jv-speler" type="button" data-yt={OPNAME.yt} aria-label={t(taal, 'jv.opnameSpeel')}>
        <img src="/assets/opname-java-2027.jpg" alt="" width="1280" height="720" loading="lazy" decoding="async" />
        <span class="jv-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="jv-duur">{t(taal, 'jv.opnameDuur').replace('{duur}', OPNAME.duur)}</span>
      </button>
    </div>
  </section>
  )}

  <!-- PROGRAMMA -->
  <section class="block" id="programma">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.progKicker')}</span>
        <h2>{t(taal, 'jv.progTitel')}</h2>
        <p>{t(taal, 'jv.progTekst')}</p>
      </div>

      <div class="news-grid">
        {programma.map((p) => (
          <article class="news jv-kaart">
            <div class="thumb" style={`background-image:url('${p.foto}')`}></div>
            <div class="np">
              <span class="cat">{p.cat}</span>
              <h3>{p.titel}</h3>
              <p>{p.tekst}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DAG VOOR DAG -->
  <section class="block vervolg" id="dagprogramma">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.dagKicker')}</span>
        <h2>{t(taal, 'jv.dagTitel')}</h2>
        <p>{t(taal, 'jv.dagTekst')}</p>
      </div>

      <div class="jv-dagen">
        {dagen.map((d) => (
          <details class="jv-dag">
            <summary>
              <span class="jv-dagnr">{t(taal, 'jv.dag')} {d.dag}</span>
              <span class="jv-dagtitel">{d.titel}</span>
              <span class="jv-dagweek">{d.weekdag}</span>
            </summary>
            <ul class="jv-dagrijen">
              {d.regels.map((r) => (
                <li>
                  <span class="jv-tijd">{r.tijd ?? ''}</span>
                  <span class="jv-wat">
                    {r.wat}
                    {r.waar && <em>{r.waar}</em>}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

      <p class="jv-klein" style="margin-top:22px">{t(taal, 'jv.dagVoet')}</p>
    </div>
  </section>

  <!-- WAAR JE SLAAPT -->
  <section class="block prod" id="hotel">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.hotelKicker')}</span>
        <h2>{t(taal, 'jv.hotelTitel')}</h2>
        <p>{t(taal, 'jv.hotelTekst')}</p>
      </div>

      <div class="jv-hotel">
        <figure><img src="/assets/java2027/hotel/zwembad.jpg" alt={t(taal, 'jv.hotelAltZwembad')} loading="lazy" width="720" height="1280" /></figure>
        <figure><img src="/assets/java2027/hotel/bungalows.jpg" alt={t(taal, 'jv.hotelAltBungalows')} loading="lazy" width="720" height="1280" /></figure>
        <figure><img src="/assets/java2027/hotel/tuin.jpg" alt={t(taal, 'jv.hotelAltTuin')} loading="lazy" width="720" height="1280" /></figure>
      </div>

      <p class="jv-klein" style="margin-top:18px">
        <a class="jv-link" href="https://www.puripangeran.com/" target="_blank" rel="noopener">
          {t(taal, 'jv.hotelLink')}
        </a>
      </p>
    </div>
  </section>

  <!-- PRIJS -->
  <section class="block jv-prijs">
    <div class="wrap">
      <div class="jv-prijs-grid">
        <div>
          <span class="kicker">{t(taal, 'jv.prijsKicker')}</span>
          <p class="jv-bedrag">{euro(REIS.prijsVolwassene)}</p>
          <p class="jv-bedrag-onder">{t(taal, 'jv.prijsOnder')}</p>
          <ul class="jv-tarieven">
            <li>
              <strong>{euro(REIS.prijsVolwassene)}</strong>
              <span>{t(taal, 'jv.tariefVolwassene').replace('{leeftijd}', String(REIS.volwassenVanaf))}</span>
            </li>
            <li>
              <strong>{euro(REIS.prijsKind)}</strong>
              <span>
                {t(taal, 'jv.tariefKind')
                  .replace('{van}', String(REIS.kindVanaf))
                  .replace('{tot}', String(REIS.volwassenVanaf - 1))}
              </span>
            </li>
            <li>
              <strong>{t(taal, 'jv.gratis')}</strong>
              <span>{t(taal, 'jv.tariefBaby').replace('{leeftijd}', String(REIS.kindVanaf))}</span>
            </li>
          </ul>
        </div>
        <div class="jv-incl">
          <div>
            <h3>{t(taal, 'jv.inclKop')}</h3>
            <ul class="jv-ja">{inbegrepen.map((r) => <li>{r}</li>)}</ul>
          </div>
          <div>
            <h3>{t(taal, 'jv.exclKop')}</h3>
            <ul class="jv-nee">{nietInbegrepen.map((r) => <li>{r}</li>)}</ul>
          </div>
        </div>
      </div>
      <p class="jv-voet">{t(taal, 'jv.prijsVoet')}</p>
    </div>
  </section>

  <!-- TERMIJNEN -->
  <section class="block prod jv-termijnen">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.betKicker')}</span>
        <h2>{t(taal, 'jv.betTitel')}</h2>
        <p>{t(taal, 'jv.betTekst')}</p>
      </div>

      <div class="jv-rij">
        {termijnen.map((tm) => (
          <div class="jv-termijn">
            <span class="jv-stap">{tm.kop}</span>
            <span class="jv-euro">{tm.bedrag}</span>
            <span class="jv-datum">{t(taal, 'jv.uiterlijk')} {tm.datum}</span>
            <div class="jv-balk"><i style={`width:${tm.betaald}%`}></i></div>
            <span class="jv-deel">{tm.betaald}% {t(taal, 'jv.betaald')}</span>
            <p>{tm.tekst}</p>
          </div>
        ))}
      </div>

      <p class="jv-soepel">{t(taal, 'jv.betDatums')}</p>
      <p class="jv-soepel">{t(taal, 'jv.betSoepel')}</p>
    </div>
  </section>

  <!-- RESERVEREN -->
  <section class="block" id="reserveren">
    <div class="wrap">
      <div class="split jv-res">
        <div>
          <div class="section-head" style="margin-bottom:22px">
            <span class="kicker">{t(taal, 'jv.resKicker')}</span>
            <h2>{t(taal, 'jv.resTitel')}</h2>
            <p>{t(taal, 'jv.resTekst')}</p>
            <p class="jv-sluit">{t(taal, 'jv.sluit').replace('{datum}', datum(REIS.reserverenTot))}</p>
          </div>
          {REIS.open ? (
            <form
              class="jv-boek"
              id="boekform"
              data-url={BOEK_URL}
              data-volwassene={REIS.prijsVolwassene}
              data-kind={REIS.prijsKind}
              data-deel={REIS.termijnen[0]?.deel ?? 25}
              data-taal={taal}
              data-msg-plekken={t(taal, 'jv.plekkenVrij')}
              data-msg-vol={t(taal, 'jv.plekkenVol')}
            >
              <p class="jv-plekken" data-plekken hidden></p>

              <fieldset class="jv-aantallen">
                <legend>{t(taal, 'jv.wieGaanMee')}</legend>

                <label>
                  <span class="jv-alabel">
                    {t(taal, 'jv.aVolwassenen').replace('{leeftijd}', String(REIS.volwassenVanaf))}
                    <small>{euro(REIS.prijsVolwassene)} p.p.</small>
                  </span>
                  <input type="number" name="volwassenen" min="1" max="10" value="2" inputmode="numeric" required />
                </label>

                <label>
                  <span class="jv-alabel">
                    {t(taal, 'jv.aKinderen')
                      .replace('{van}', String(REIS.kindVanaf))
                      .replace('{tot}', String(REIS.volwassenVanaf - 1))}
                    <small>{euro(REIS.prijsKind)} p.p.</small>
                  </span>
                  <input type="number" name="kinderen" min="0" max="10" value="0" inputmode="numeric" />
                </label>

                <label>
                  <span class="jv-alabel">
                    {t(taal, 'jv.aBabys').replace('{leeftijd}', String(REIS.kindVanaf))}
                    <small>{t(taal, 'jv.gratis')}</small>
                  </span>
                  <input type="number" name="babys" min="0" max="6" value="0" inputmode="numeric" />
                </label>
              </fieldset>

              <div class="jv-som" aria-live="polite">
                <div>
                  <span>{t(taal, 'jv.somTotaal')}</span>
                  <strong data-som-totaal>{euroCent(REIS.prijsVolwassene * 2)}</strong>
                </div>
                <div class="jv-som-nu">
                  <span>{t(taal, 'jv.somNu')}</span>
                  <strong data-som-nu>{euroCent(eersteVolwassene * 2)}</strong>
                </div>
              </div>

              <div class="jv-velden">
                <label>
                  {t(taal, 'jv.vNaam')}
                  <input type="text" name="naam" required autocomplete="name" />
                </label>
                <label>
                  {t(taal, 'jv.vEmail')}
                  <input type="email" name="email" required autocomplete="email" />
                </label>
                <label>
                  {t(taal, 'jv.vTelefoon')}
                  <input type="tel" name="telefoon" autocomplete="tel" />
                </label>
                <label class="jv-breed">
                  {t(taal, 'jv.vOpmerking')}
                  <textarea name="opmerking" rows="2"></textarea>
                </label>
              </div>

              <input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />

              <button class="btn gold jv-groot" type="submit">
                {t(taal, 'jv.resKnop')} — <span data-som-knop>{euroCent(eersteVolwassene * 2)}</span>
              </button>
              <p class="jv-status" data-boek-status role="status" aria-live="polite"></p>
              <p class="jv-klein">{t(taal, 'jv.resKlein')}</p>
            </form>
          ) : (
            <div class="jv-gesloten">
              <p>{t(taal, 'jv.gesloten')}</p>
              <a class="btn gold" href={`mailto:${MAILADRES}?subject=${encodeURIComponent(t(taal, 'jv.mailOnderwerp'))}`}>
                {t(taal, 'jv.contactMail')}
              </a>
            </div>
          )}
        </div>

        <div class="info-card">
          <h3>{t(taal, 'jv.stappenKop')}</h3>
          <ol class="jv-stappen">
            {stappen.map((s) => (
              <li><div><strong>{s.kop}</strong><span>{s.tekst}</span></div></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- VRAGEN -->
  <section class="block vervolg">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.vraagKicker')}</span>
        <h2>{t(taal, 'jv.vraagTitel')}</h2>
      </div>
      <div class="jv-vragen">

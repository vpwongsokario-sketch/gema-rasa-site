<script>
  /**
   * Het boekformulier: meerekenen en doorsturen naar de betaling.
   *
   * Het bedrag dat hier wordt uitgerekend is om te laten zien wat het wordt.
   * Wat er werkelijk wordt afgeschreven, rekent de server opnieuw uit met de
   * prijzen uit de administratie — anders zou iemand met een aangepaste pagina
   * zijn eigen prijs kunnen bepalen.
   */
  const form = document.getElementById('boekform') as HTMLFormElement | null;

  if (form) {
    const taal = form.dataset.taal || 'nl';
    const prijsVolwassene = Number(form.dataset.volwassene) || 0;
    const prijsKind = Number(form.dataset.kind) || 0;
    const deel = Number(form.dataset.deel) || 25;
    const url = form.dataset.url!;

    const geld = new Intl.NumberFormat(
      { nl: 'nl-NL', en: 'en-GB', id: 'id-ID' }[taal] || 'nl-NL',
      { style: 'currency', currency: 'EUR', minimumFractionDigits: 2 },
    );

    const status = form.querySelector<HTMLElement>('[data-boek-status]');
    const knop = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const velden = {
      totaal: form.querySelector<HTMLElement>('[data-som-totaal]'),
      nu: form.querySelector<HTMLElement>('[data-som-nu]'),
      opKnop: form.querySelector<HTMLElement>('[data-som-knop]'),
    };

    const getal = (naam: string) => {
      const el = form.elements.namedItem(naam) as HTMLInputElement | null;
      const n = Number(el?.value);
      return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
    };

    const rekenen = () => {
      /**
       * In centen rekenen, net als de server.
       *
       * In euro's rekenen en dan afronden maakt van € 687,50 een € 688, en dan
       * staat er op het scherm een ander bedrag dan Mollie vraagt.
       */
      const totaalCenten =
        getal('volwassenen') * Math.round(prijsVolwassene * 100) +
        getal('kinderen') * Math.round(prijsKind * 100);
      const totaal = totaalCenten / 100;
      const nu = Math.round((totaalCenten * deel) / 100) / 100;
      if (velden.totaal) velden.totaal.textContent = geld.format(totaal);
      if (velden.nu) velden.nu.textContent = geld.format(nu);
      if (velden.opKnop) velden.opKnop.textContent = geld.format(nu);
    };

    form.addEventListener('input', rekenen);
    rekenen();

    /**
     * Hoeveel plekken er nog vrij zijn, opgehaald op het moment van kijken.
     *
     * Deze pagina wordt gebouwd en blijft dan staan. Zou het aantal erin
     * gebakken zitten, dan staat er dagen later nog 'nog 12 plekken' terwijl de
     * reis vol is. Lukt het ophalen niet, dan staat er niets — beter geen getal
     * dan een verkeerd getal.
     */
    const plekkenRegel = form.querySelector<HTMLElement>('[data-plekken]');
    fetch(url.replace('/boeken', '/plekken'))
      .then((r) => (r.ok ? r.json() : null))
      .then((p) => {
        if (!p || !plekkenRegel) return;
        if (p.open === false) {
          plekkenRegel.textContent = form.dataset.msgVol || '';
          plekkenRegel.className = 'jv-plekken vol';
          plekkenRegel.hidden = !plekkenRegel.textContent;
          knop?.setAttribute('disabled', 'disabled');
          return;
        }
        if (typeof p.vrij === 'number' && typeof p.max === 'number') {
          plekkenRegel.textContent = (form.dataset.msgPlekken || '')
            .replace('{vrij}', String(p.vrij))
            .replace('{max}', String(p.max));
          plekkenRegel.hidden = !plekkenRegel.textContent;
        }
      })
      .catch(() => {
        /* niets tonen */
      });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !knop) return;

      knop.disabled = true;
      status.textContent = form.dataset.msgBezig || 'Bezig…';
      status.className = 'jv-status';

      try {
        const antwoord = await fetch(url, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form) as any)),
        });
        const uitslag = await antwoord.json().catch(() => ({}));
        if (!antwoord.ok || !uitslag.betaallink) {
          throw new Error(uitslag.error || 'Het lukte niet');
        }
        // Naar de betaalomgeving van Mollie.
        window.location.href = uitslag.betaallink;
      } catch (fout) {
        status.textContent = fout instanceof Error ? fout.message : 'Het lukte niet';
        status.className = 'jv-status mis';
        knop.disabled = false;
      }
    });
  }
  /* De opname: pas bij een klik wordt YouTube geladen. */
  for (const knop of document.querySelectorAll<HTMLButtonElement>('.jv-speler[data-yt]')) {
    knop.addEventListener('click', () => {
      const id = knop.dataset.yt;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.title = knop.getAttribute('aria-label') || '';
      knop.replaceWith(frame);
      frame.classList.add('jv-frame');
      frame.focus();
    }, { once: true });
  }
</script>


---
/**
 * Educatiereis Java 2027 — aanbetalingspagina.
 *
 * Bedragen, data en de betaallink staan hieronder in REIS: dat is de enige
 * plek waar je ze hoeft te wijzigen. De teksten staan in src/i18n/java2027.ts.
 */
import { taalPaden, t } from '../../i18n/index.ts';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getPaginaSeo, getReis } from '../../lib/sanity.ts';

export const getStaticPaths = taalPaden;
const { taal } = Astro.props;
const paginaSeo = await getPaginaSeo('educatiereis-java-2027');

/**
 * De reis en de prijzen komen uit Sanity.
 *
 * Daar staan ze omdat ze van het bestuur zijn en op twee plekken worden
 * gebruikt: hier, en bij het platform dat de betaling aanmaakt. Stonden ze op
 * beide plekken los in de code, dan verandert er ooit eentje en staat er op
 * deze pagina een ander bedrag dan er wordt afgeschreven.
 *
 * Valt Sanity weg, dan gelden de waarden hieronder. Beter een pagina met de
 * bekende prijzen dan een pagina die niet laadt.
 */
const uitSanity = await getReis();

const REIS = {
  prijsVolwassene: uitSanity?.prijsVolwassene ?? 1000,
  prijsKind: uitSanity?.prijsKind ?? 750,
  kindVanaf: uitSanity?.kindVanaf ?? 3,
  volwassenVanaf: uitSanity?.volwassenVanaf ?? 11,
  vertrek: uitSanity?.vertrek ?? '2027-08-01',
  terug: uitSanity?.terug ?? '2027-08-15',
  reserverenTot: uitSanity?.reserverenTot ?? '2026-10-31',
  open: uitSanity?.open !== false,
  termijnen:
    uitSanity?.termijnen?.length
      ? uitSanity.termijnen
      : [
          { deel: 25, vervaldatum: '2026-10-31' },
          { deel: 37.5, vervaldatum: '2026-12-15' },
          { deel: 37.5, vervaldatum: '2027-05-15' },
        ],
};

/**
 * Het deel dat bij de eerste termijn hoort, en wat dat is voor één volwassene.
 *
 * Op drie plekken nodig: de knop bovenaan, het beginbedrag in het formulier en
 * de knop onderaan. Eén keer uitrekenen, anders staat er ergens een getal dat
 * niet meer klopt als de verdeling verandert.
 */
const eersteDeel = Number(REIS.termijnen[0]?.deel) || 25;
const eersteVolwassene = Math.round((REIS.prijsVolwassene * eersteDeel) / 100);

/** Waar de boeking naartoe gaat. Daar staat de Mollie-sleutel. */
const BOEK_URL = 'https://beheer.stichtinggemarasa.com/api/reis/boeken';

/** Het nummer waarop de stichting bereikbaar is, in het formaat van wa.me. */
const WHATSAPP = '31615045418';
const MAILADRES = 'info@stichtinggemarasa.com';

const loc = { nl: 'nl-NL', en: 'en-GB', id: 'id-ID' }[taal];
const euro = (n: number) =>
  new Intl.NumberFormat(loc, { style: 'currency', currency: 'EUR', minimumFractionDigits: 0 }).format(n);
const datum = (iso: string) =>
  new Intl.DateTimeFormat(loc, { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));

const reisperiode = `${new Date(REIS.vertrek).getDate()} — ${datum(REIS.terug)}`;

const fotos = ['gamelan', 'koken', 'museum', 'borobudur', 'rivier', 'ramayana'];
const programma = fotos.map((naam, i) => ({
  foto: `/assets/java2027/${naam}.jpg`,
  cat: t(taal, `jv.p${i + 1}cat`),
  titel: t(taal, `jv.p${i + 1}t`),
  tekst: t(taal, `jv.p${i + 1}b`),
}));

/**
 * De termijnen, gerekend vanaf het volwassenentarief.
 *
 * In procenten in Sanity, hier omgerekend naar bedragen. Voor een kind komt er
 * met dezelfde percentages een lager bedrag uit; wat een gezin werkelijk
 * betaalt, rekent het formulier hieronder uit.
 */
let opgeteld = 0;
const termijnen = REIS.termijnen.map((tm: any, i: number) => {
  const bedrag = Math.round((REIS.prijsVolwassene * (Number(tm.deel) || 0)) / 100);
  opgeteld += bedrag;
  return {
    kop: t(taal, `jv.t${i + 1}kop`),
    tekst: t(taal, `jv.t${i + 1}b`),
    bedrag: euro(bedrag),
    datum: tm.vervaldatum ? datum(tm.vervaldatum) : '',
    deel: Math.round(Number(tm.deel) || 0),
    betaald: Math.round((opgeteld / REIS.prijsVolwassene) * 100),
  };
});

const inbegrepen = [1, 2, 3, 4, 5, 6, 7, 8].map((i) => t(taal, `jv.incl${i}`));
const nietInbegrepen = [1, 2, 3, 4, 5, 6].map((i) => t(taal, `jv.excl${i}`));
const stappen = [1, 2, 3, 4].map((i) => ({ kop: t(taal, `jv.s${i}t`), tekst: t(taal, `jv.s${i}b`) }));
const vragen = [1, 2, 3, 4, 5, 6].map((i) => ({ vraag: t(taal, `jv.v${i}`), antwoord: t(taal, `jv.a${i}`) }));
---

<Base
  taal={taal}
  seo={paginaSeo}
  title={`${t(taal, 'jv.titel')} — Stichting Gema Rasa`}
  description={t(taal, 'jv.intro')}
  ogImage="/assets/java2027/ramayana.jpg"
>
  <PageHero
    sleutel="educatiereis-java-2027"
    eyebrow={t(taal, 'jv.eyebrow')}
    titel={t(taal, 'jv.titel')}
    tekst={t(taal, 'jv.intro')}
    foto="/assets/java2027/hero.jpg"
    positie="center"
  >
    <div class="jv-hero-cta">
      <a class="btn gold" href="#reserveren">{t(taal, 'jv.heroKnop')} — {euro(eersteVolwassene)}</a>
      <a class="btn jv-ghost" href="#programma">{t(taal, 'jv.heroKnop2')}</a>
    </div>
  </PageHero>

  <div class="strip">
    <div class="wrap">
      <div><b>{reisperiode}</b> · {t(taal, 'jv.dagen')}</div>
      <div><b>{t(taal, 'jv.plaats')}</b> · Java, Indonesië</div>
      <div>{t(taal, 'jv.reserverenTot')} <b>{datum(REIS.reserverenTot)}</b></div>
    </div>
  </div>

  <!-- PROGRAMMA -->
  <section class="block" id="programma">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.progKicker')}</span>
        <h2>{t(taal, 'jv.progTitel')}</h2>
        <p>{t(taal, 'jv.progTekst')}</p>
      </div>

      <div class="news-grid">
        {programma.map((p) => (
          <article class="news jv-kaart">
            <div class="thumb" style={`background-image:url('${p.foto}')`}></div>
            <div class="np">
              <span class="cat">{p.cat}</span>
              <h3>{p.titel}</h3>
              <p>{p.tekst}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PRIJS -->
  <section class="block jv-prijs" style="padding-top:0">
    <div class="wrap">
      <div class="jv-prijs-grid">
        <div>
          <span class="kicker">{t(taal, 'jv.prijsKicker')}</span>
          <p class="jv-bedrag">{euro(REIS.prijsVolwassene)}</p>
          <p class="jv-bedrag-onder">{t(taal, 'jv.prijsOnder')}</p>
          <ul class="jv-tarieven">
            <li>
              <strong>{euro(REIS.prijsVolwassene)}</strong>
              <span>{t(taal, 'jv.tariefVolwassene').replace('{leeftijd}', String(REIS.volwassenVanaf))}</span>
            </li>
            <li>
              <strong>{euro(REIS.prijsKind)}</strong>
              <span>
                {t(taal, 'jv.tariefKind')
                  .replace('{van}', String(REIS.kindVanaf))
                  .replace('{tot}', String(REIS.volwassenVanaf - 1))}
              </span>
            </li>
            <li>
              <strong>{t(taal, 'jv.gratis')}</strong>
              <span>{t(taal, 'jv.tariefBaby').replace('{leeftijd}', String(REIS.kindVanaf))}</span>
            </li>
          </ul>
        </div>
        <div class="jv-incl">
          <div>
            <h3>{t(taal, 'jv.inclKop')}</h3>
            <ul class="jv-ja">{inbegrepen.map((r) => <li>{r}</li>)}</ul>
          </div>
          <div>
            <h3>{t(taal, 'jv.exclKop')}</h3>
            <ul class="jv-nee">{nietInbegrepen.map((r) => <li>{r}</li>)}</ul>
          </div>
        </div>
      </div>
      <p class="jv-voet">{t(taal, 'jv.prijsVoet')}</p>
    </div>
  </section>

  <!-- TERMIJNEN -->
  <section class="block prod jv-termijnen">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.betKicker')}</span>
        <h2>{t(taal, 'jv.betTitel')}</h2>
        <p>{t(taal, 'jv.betTekst')}</p>
      </div>

      <div class="jv-rij">
        {termijnen.map((tm) => (
          <div class="jv-termijn">
            <span class="jv-stap">{tm.kop}</span>
            <span class="jv-euro">{tm.bedrag}</span>
            <span class="jv-datum">{t(taal, 'jv.uiterlijk')} {tm.datum}</span>
            <div class="jv-balk"><i style={`width:${tm.betaald}%`}></i></div>
            <span class="jv-deel">{tm.betaald}% {t(taal, 'jv.betaald')}</span>
            <p>{tm.tekst}</p>
          </div>
        ))}
      </div>

      <p class="jv-soepel">{t(taal, 'jv.betSoepel')}</p>
    </div>
  </section>

  <!-- RESERVEREN -->
  <section class="block" id="reserveren">
    <div class="wrap">
      <div class="split jv-res">
        <div>
          <div class="section-head" style="margin-bottom:22px">
            <span class="kicker">{t(taal, 'jv.resKicker')}</span>
            <h2>{t(taal, 'jv.resTitel')}</h2>
            <p>{t(taal, 'jv.resTekst')}</p>
          </div>
          {REIS.open ? (
            <form
              class="jv-boek"
              id="boekform"
              data-url={BOEK_URL}
              data-volwassene={REIS.prijsVolwassene}
              data-kind={REIS.prijsKind}
              data-deel={REIS.termijnen[0]?.deel ?? 25}
              data-taal={taal}
            >
              <fieldset class="jv-aantallen">
                <legend>{t(taal, 'jv.wieGaanMee')}</legend>

                <label>
                  <span class="jv-alabel">
                    {t(taal, 'jv.aVolwassenen').replace('{leeftijd}', String(REIS.volwassenVanaf))}
                    <small>{euro(REIS.prijsVolwassene)} p.p.</small>
                  </span>
                  <input type="number" name="volwassenen" min="1" max="10" value="2" inputmode="numeric" required />
                </label>

                <label>
                  <span class="jv-alabel">
                    {t(taal, 'jv.aKinderen')
                      .replace('{van}', String(REIS.kindVanaf))
                      .replace('{tot}', String(REIS.volwassenVanaf - 1))}
                    <small>{euro(REIS.prijsKind)} p.p.</small>
                  </span>
                  <input type="number" name="kinderen" min="0" max="10" value="0" inputmode="numeric" />
                </label>

                <label>
                  <span class="jv-alabel">
                    {t(taal, 'jv.aBabys').replace('{leeftijd}', String(REIS.kindVanaf))}
                    <small>{t(taal, 'jv.gratis')}</small>
                  </span>
                  <input type="number" name="babys" min="0" max="6" value="0" inputmode="numeric" />
                </label>
              </fieldset>

              <div class="jv-som" aria-live="polite">
                <div>
                  <span>{t(taal, 'jv.somTotaal')}</span>
                  <strong data-som-totaal>{euro(REIS.prijsVolwassene * 2)}</strong>
                </div>
                <div class="jv-som-nu">
                  <span>{t(taal, 'jv.somNu')}</span>
                  <strong data-som-nu>{euro(eersteVolwassene * 2)}</strong>
                </div>
              </div>

              <div class="jv-velden">
                <label>
                  {t(taal, 'jv.vNaam')}
                  <input type="text" name="naam" required autocomplete="name" />
                </label>
                <label>
                  {t(taal, 'jv.vEmail')}
                  <input type="email" name="email" required autocomplete="email" />
                </label>
                <label>
                  {t(taal, 'jv.vTelefoon')}
                  <input type="tel" name="telefoon" autocomplete="tel" />
                </label>
                <label class="jv-breed">
                  {t(taal, 'jv.vOpmerking')}
                  <textarea name="opmerking" rows="2"></textarea>
                </label>
              </div>

              <input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />

              <button class="btn gold jv-groot" type="submit">
                {t(taal, 'jv.resKnop')} — <span data-som-knop>{euro(eersteVolwassene * 2)}</span>
              </button>
              <p class="jv-status" data-boek-status role="status" aria-live="polite"></p>
              <p class="jv-klein">{t(taal, 'jv.resKlein')}</p>
            </form>
          ) : (
            <div class="jv-gesloten">
              <p>{t(taal, 'jv.gesloten')}</p>
              <a class="btn gold" href={`mailto:${MAILADRES}?subject=${encodeURIComponent(t(taal, 'jv.mailOnderwerp'))}`}>
                {t(taal, 'jv.contactMail')}
              </a>
            </div>
          )}
        </div>

        <div class="info-card">
          <h3>{t(taal, 'jv.stappenKop')}</h3>
          <ol class="jv-stappen">
            {stappen.map((s) => (
              <li><div><strong>{s.kop}</strong><span>{s.tekst}</span></div></li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- VRAGEN -->
  <section class="block" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <span class="kicker">{t(taal, 'jv.vraagKicker')}</span>
        <h2>{t(taal, 'jv.vraagTitel')}</h2>
      </div>
      <div class="jv-vragen">
        {vragen.map((v) => (
          <details>
            <summary>{v.vraag}</summary>
            <div class="jv-antwoord">{v.antwoord}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="block prod" id="contact" style="padding-top:0">
    <div class="wrap">
      <div class="split jv-contact">
        <div>
          <div class="section-head" style="margin-bottom:20px">
            <span class="kicker">{t(taal, 'jv.contactKicker')}</span>
            <h2>{t(taal, 'jv.contactTitel')}</h2>
            <p>{t(taal, 'jv.contactTekst')}</p>
          </div>

          <div class="jv-direct">
            <a
              class="btn gold"
              href={`https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t(taal, 'jv.waTekst'))}`}
              target="_blank"
              rel="noopener"
            >
              {t(taal, 'jv.contactWhatsapp')}
            </a>
            <a
              class="btn jv-ghost"
              href={`mailto:${MAILADRES}?subject=${encodeURIComponent(t(taal, 'jv.mailOnderwerp'))}`}
            >
              {t(taal, 'jv.contactMail')}
            </a>
          </div>
          <p class="jv-klein">{t(taal, 'jv.contactSnel')}</p>
        </div>

        <div class="info-card">
          <h3>{t(taal, 'jv.formTitel')}</h3>
          <form
            class="jv-vraagform"
            data-formulier="contact"
            data-bedankt={t(taal, 'jv.formBedankt')}
          >
            <input type="hidden" name="onderwerp" value={t(taal, 'jv.mailOnderwerp')} />
            <label>
              {t(taal, 'jv.vNaam')}
              <input type="text" name="naam" required autocomplete="name" />
            </label>
            <label>
              {t(taal, 'jv.vEmail')}
              <input type="email" name="email" required autocomplete="email" />
            </label>
            <label>
              {t(taal, 'jv.vVraag')}
              <textarea name="bericht" rows="4" required></textarea>
            </label>
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
            <button class="btn gold" type="submit">{t(taal, 'jv.formKnop')}</button>
            <p class="form-status" data-status role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  /**
   * Het boekformulier: meerekenen en doorsturen naar de betaling.
   *
   * Het bedrag dat hier wordt uitgerekend is om te laten zien wat het wordt.
   * Wat er werkelijk wordt afgeschreven, rekent de server opnieuw uit met de
   * prijzen uit de administratie — anders zou iemand met een aangepaste pagina
   * zijn eigen prijs kunnen bepalen.
   */
  const form = document.getElementById('boekform') as HTMLFormElement | null;

  if (form) {
    const taal = form.dataset.taal || 'nl';
    const prijsVolwassene = Number(form.dataset.volwassene) || 0;
    const prijsKind = Number(form.dataset.kind) || 0;
    const deel = Number(form.dataset.deel) || 25;
    const url = form.dataset.url!;

    const geld = new Intl.NumberFormat(
      { nl: 'nl-NL', en: 'en-GB', id: 'id-ID' }[taal] || 'nl-NL',
      { style: 'currency', currency: 'EUR' },
    );

    const status = form.querySelector<HTMLElement>('[data-boek-status]');
    const knop = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const velden = {
      totaal: form.querySelector<HTMLElement>('[data-som-totaal]'),
      nu: form.querySelector<HTMLElement>('[data-som-nu]'),
      opKnop: form.querySelector<HTMLElement>('[data-som-knop]'),
    };

    const getal = (naam: string) => {
      const el = form.elements.namedItem(naam) as HTMLInputElement | null;
      const n = Number(el?.value);
      return Number.isFinite(n) && n > 0 ? Math.floor(n) : 0;
    };

    const rekenen = () => {
      const totaal = getal('volwassenen') * prijsVolwassene + getal('kinderen') * prijsKind;
      // Naar boven afgerond op hele centen, net als op de server.
      const nu = Math.round((totaal * deel) / 100);
      if (velden.totaal) velden.totaal.textContent = geld.format(totaal);
      if (velden.nu) velden.nu.textContent = geld.format(nu);
      if (velden.opKnop) velden.opKnop.textContent = geld.format(nu);
    };

    form.addEventListener('input', rekenen);
    rekenen();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !knop) return;

      knop.disabled = true;
      status.textContent = form.dataset.msgBezig || 'Bezig…';
      status.className = 'jv-status';

      try {
        const antwoord = await fetch(url, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form) as any)),
        });
        const uitslag = await antwoord.json().catch(() => ({}));
        if (!antwoord.ok || !uitslag.betaallink) {
          throw new Error(uitslag.error || 'Het lukte niet');
        }
        // Naar de betaalomgeving van Mollie.
        window.location.href = uitslag.betaallink;
      } catch (fout) {
        status.textContent = fout instanceof Error ? fout.message : 'Het lukte niet';
        status.className = 'jv-status mis';
        knop.disabled = false;
      }
    });
  }
</script>

<style>
  /* hero-knoppen in de paginakop */
  .jv-hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 26px; }
  .jv-ghost {
    background: transparent; color: var(--cream);
    border: 1.5px solid rgba(244, 243, 232, .5);
  }
  .jv-ghost:hover { background: rgba(244, 243, 232, .12); border-color: var(--primary); }

  /* programma-kaarten: geen link, dus geen zweefeffect */
  .jv-kaart:hover { transform: none; box-shadow: none; }
  .jv-kaart .thumb { background-position: center; }

  /* prijs */
  .jv-prijs-grid {
    display: grid; grid-template-columns: .8fr 1.2fr; gap: 46px; align-items: start;
    background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 44px;
    box-shadow: 0 18px 50px rgba(9, 53, 31, .08);
  }
  .jv-bedrag {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700;
    font-size: clamp(42px, 5.6vw, 64px); color: var(--secondary);
    line-height: 1; margin-top: 12px; font-variant-numeric: tabular-nums;
  }
  .jv-bedrag-onder { font-family: 'Poppins', sans-serif; font-size: 14px; color: var(--gray); margin-top: 10px; }
  .jv-incl { display: grid; grid-template-columns: 1fr 1fr; gap: 34px; }
  .jv-incl h3 {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 600; letter-spacing: .1em;
    text-transform: uppercase; color: var(--primary-dark);
    padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 14px;
  }
  .jv-incl ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .jv-incl li {
    font-family: 'Poppins', sans-serif; font-weight: 300; font-size: 14.5px; color: #4a4a4a;
    line-height: 1.5; padding-left: 22px; position: relative;
  }
  .jv-ja li::before {
    content: ""; position: absolute; left: 0; top: 8px; width: 9px; height: 9px;
    border-radius: 50%; background: var(--primary);
  }
  .jv-nee li::before {
    content: ""; position: absolute; left: 0; top: 12px; width: 10px; height: 2px;
    background: rgba(9, 53, 31, .3);
  }
  .jv-voet {
    font-family: 'Poppins', sans-serif; font-size: 13.5px; color: var(--gray);
    margin-top: 20px; font-style: italic;
  }

  /* termijnen (donkere sectie) */
